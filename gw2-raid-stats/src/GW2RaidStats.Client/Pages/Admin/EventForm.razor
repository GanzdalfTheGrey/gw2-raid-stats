@page "/admin/events/new"
@page "/admin/events/{Id:guid}/edit"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@using GW2RaidStats.Core.Events

<PageTitle>GW2 Raid Stats - @(_isNew ? "New Event" : "Edit Event")</PageTitle>

<AdminAuth>
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@(_isNew ? "New Event" : "Edit Event")</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/admin/events">Back to list</MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (_guilds.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            No Discord guild configurations found. Configure the bot in a guild first
            (<code>/config notifications #channel</code>) before creating events.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="long" @bind-Value="_form.GuildId"
                               Label="Discord guild" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var g in _guilds)
                        {
                            <MudSelectItem Value="@g.GuildId">@(string.IsNullOrEmpty(g.GuildName) ? g.GuildId.ToString() : g.GuildName)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="_form.Title" Label="Title" Required="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_form.Description" Label="Description"
                                  Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_date" Label="Date" Required="true"
                                   Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTimePicker @bind-Time="_time" Label="Time" Required="true"
                                   AmPm="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_form.Timezone" Label="Timezone (IANA)" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var tz in _timezones)
                        {
                            <MudSelectItem Value="@tz">@tz</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mt-2 mb-1" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h6">Role slots</MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AutoFixHigh"
                                   OnClick="ApplyStandardRaidPreset">
                            Use Standard Raid preset
                        </MudButton>
                    </MudStack>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Leave empty for a generic Sign Up / Reserve event. Role and Boon tags are used by
                        the squad boon-cap enforcement (toggle below) and by Squad Builder seeding to
                        auto-assign player roles. Signups that overflow a slot or a cap go to Reserve.
                    </MudText>
                    @if (_form.RoleSlots.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            No role slots — signups will be Sign Up / Reserve only.
                        </MudAlert>
                    }
                    @foreach (var slot in _form.RoleSlots)
                    {
                        var captureSlot = slot;
                        <MudGrid Class="mb-1" Spacing="2">
                            <MudItem xs="12" md="4">
                                <MudTextField T="string" @bind-Value="captureSlot.Label"
                                              Label="Role label" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="4" md="1">
                                <MudNumericField T="int" @bind-Value="captureSlot.Count"
                                                 Label="Count" Min="1" Max="50"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="4" md="3">
                                <MudSelect T="string" @bind-Value="captureSlot.Role"
                                           Label="Role" Clearable="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@((string?)"heal")">Heal</MudSelectItem>
                                    <MudSelectItem Value="@((string?)"boondps")">Boon DPS</MudSelectItem>
                                    <MudSelectItem Value="@((string?)"dps")">DPS</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="4" md="3">
                                <MudSelect T="string" @bind-Value="captureSlot.Boon"
                                           Label="Boon" Clearable="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem Value="@((string?)"quick")">Quickness</MudSelectItem>
                                    <MudSelectItem Value="@((string?)"alac")">Alacrity</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="1" Class="d-flex align-center">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error"
                                               OnClick="@(() => RemoveSlot(captureSlot))" />
                            </MudItem>
                        </MudGrid>
                    }
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddSlot" Class="mt-2">
                        Add slot
                    </MudButton>
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_form.EnforceBoonCaps"
                               Label="Enforce raid boon caps (max 2 Heals / 2 Boon DPS / 2 Quicks / 2 Alacs)"
                               Color="Color.Primary" />
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                <MudButton Href="/admin/events">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync" Disabled="@(_saving || !CanSave())">
                    @(_saving ? "Saving..." : "Save")
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</AdminAuth>

@code {
    [Parameter] public Guid? Id { get; set; }

    private static readonly string[] BaseTimezones = new[]
    {
        "UTC",
        "America/New_York", "America/Chicago", "America/Denver",
        "America/Los_Angeles", "America/Anchorage", "Pacific/Honolulu",
        "Europe/London", "Europe/Berlin", "Europe/Moscow",
        "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Tokyo",
        "Australia/Sydney"
    };

    private bool _isNew => Id == null;
    private bool _loading = true;
    private bool _saving = false;
    private DateTime? _date = DateTime.Today.AddDays(1);
    private TimeSpan? _time = new TimeSpan(19, 0, 0);
    private List<GuildOption> _guilds = new();
    private List<string> _timezones = new();
    private EventFormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _timezones = new List<string>(BaseTimezones);
        var local = TimeZoneInfo.Local.Id;
        if (!_timezones.Contains(local)) _timezones.Insert(0, local);
        _form.Timezone = local;

        try
        {
            _guilds = await Http.GetFromJsonAsync<List<GuildOption>>("api/admin/bot-config") ?? new();
            if (_guilds.Count == 1) _form.GuildId = _guilds[0].GuildId;

            if (Id.HasValue)
            {
                var ev = await Http.GetFromJsonAsync<EventDetailResp>($"api/admin/events/{Id}");
                if (ev != null)
                {
                    _form.GuildId = ev.GuildId;
                    _form.Title = ev.Title;
                    _form.Description = ev.Description;
                    _form.Timezone = string.IsNullOrEmpty(ev.Timezone) ? local : ev.Timezone;
                    if (!_timezones.Contains(_form.Timezone)) _timezones.Insert(0, _form.Timezone);
                    _form.EnforceBoonCaps = ev.EnforceBoonCaps;
                    _form.RoleSlots = ev.RoleSlots?
                        .Select(s => new SlotEditRow { Id = s.Id, Label = s.Label, Count = s.Count, Role = s.Role, Boon = s.Boon })
                        .ToList() ?? new();
                    // Render the stored UTC time in the event's own TZ so the user edits
                    // the same wall-clock time they originally entered.
                    try
                    {
                        var tz = TimeZoneInfo.FindSystemTimeZoneById(_form.Timezone);
                        var inTz = TimeZoneInfo.ConvertTime(ev.ScheduledAt, tz);
                        _date = inTz.Date;
                        _time = inTz.TimeOfDay;
                    }
                    catch
                    {
                        _date = ev.ScheduledAt.LocalDateTime.Date;
                        _time = ev.ScheduledAt.LocalDateTime.TimeOfDay;
                    }
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load event", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool CanSave() => _form.GuildId != 0
                              && !string.IsNullOrWhiteSpace(_form.Title)
                              && !string.IsNullOrWhiteSpace(_form.Timezone)
                              && _date.HasValue && _time.HasValue;

    private void AddSlot() => _form.RoleSlots.Add(new SlotEditRow
    {
        // Short stable id (first 8 hex chars of a guid) — plenty for uniqueness within an event.
        Id = Guid.NewGuid().ToString("N").Substring(0, 8),
        Label = "",
        Count = 1
    });

    private void RemoveSlot(SlotEditRow slot) => _form.RoleSlots.Remove(slot);

    // One-click preset for the standard 10-stack raid composition. Slot IDs are stable
    // ("heal-quick" etc.) so Squad Builder seeding can map them to its role enum.
    private void ApplyStandardRaidPreset()
    {
        _form.RoleSlots = new List<SlotEditRow>
        {
            new() { Id = "heal-quick", Label = "Heal Quick", Count = 2, Role = "heal",    Boon = "quick" },
            new() { Id = "heal-alac",  Label = "Heal Alac",  Count = 2, Role = "heal",    Boon = "alac"  },
            new() { Id = "quick-dps",  Label = "Quick DPS",  Count = 2, Role = "boondps", Boon = "quick" },
            new() { Id = "alac-dps",   Label = "Alac DPS",   Count = 2, Role = "boondps", Boon = "alac"  },
            new() { Id = "dps",        Label = "DPS",        Count = 6, Role = "dps",     Boon = null    },
        };
        _form.EnforceBoonCaps = true;
    }

    private async Task SaveAsync()
    {
        if (!CanSave()) return;
        _saving = true;
        try
        {
            // Date + time are wall-clock in the picked timezone; convert to DateTimeOffset
            // using that zone's offset on the chosen date (handles DST correctly).
            var localDateTime = _date!.Value.Date + _time!.Value;
            TimeZoneInfo formTz;
            try { formTz = TimeZoneInfo.FindSystemTimeZoneById(_form.Timezone); }
            catch { formTz = TimeZoneInfo.Local; }
            var offset = formTz.GetUtcOffset(localDateTime);
            var scheduled = new DateTimeOffset(localDateTime, offset);

            var slots = _form.RoleSlots
                .Where(s => !string.IsNullOrWhiteSpace(s.Label) && s.Count > 0)
                .Select(s => new RoleSlot(s.Id, s.Label.Trim(), s.Count, NullIfEmpty(s.Role), NullIfEmpty(s.Boon)))
                .ToList();

            var body = new
            {
                GuildId = _form.GuildId,
                Title = _form.Title.Trim(),
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
                ScheduledAt = scheduled,
                Timezone = _form.Timezone,
                RoleSlots = slots,
                EnforceBoonCaps = _form.EnforceBoonCaps
            };

            HttpResponseMessage resp;
            if (_isNew)
            {
                resp = await Http.PostAsJsonAsync("api/admin/events", body);
            }
            else
            {
                resp = await Http.PutAsJsonAsync($"api/admin/events/{Id}", body);
            }

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(_isNew ? "Event created" : "Event saved", Severity.Success);
                Nav.NavigateTo("/admin/events");
            }
            else
            {
                Snackbar.Add("Failed to save event", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to save event", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static string? NullIfEmpty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private class EventFormModel
    {
        public long GuildId { get; set; }
        public string Title { get; set; } = "";
        public string? Description { get; set; }
        public string Timezone { get; set; } = "UTC";
        public bool EnforceBoonCaps { get; set; }
        public List<SlotEditRow> RoleSlots { get; set; } = new();
    }

    private class SlotEditRow
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public int Count { get; set; } = 1;
        public string? Role { get; set; }
        public string? Boon { get; set; }
    }

    public record GuildOption(long GuildId, string? GuildName);

    public record EventDetailResp(
        Guid Id, long GuildId, string Title, string? Description,
        DateTimeOffset ScheduledAt, string Timezone, string Status,
        List<RoleSlot>? RoleSlots, bool EnforceBoonCaps);
}
