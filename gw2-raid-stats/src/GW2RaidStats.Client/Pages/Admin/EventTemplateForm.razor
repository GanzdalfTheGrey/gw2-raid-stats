@page "/admin/events/templates/new"
@page "/admin/events/templates/{Id:guid}/edit"
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@using GW2RaidStats.Core.Events

<PageTitle>GW2 Raid Stats - @(_isNew ? "New Template" : "Edit Template")</PageTitle>

<AdminAuth>
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@(_isNew ? "New Template" : "Edit Template")</MudText>
        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" Href="/admin/events/templates">Back to templates</MudButton>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    }
    else if (_guilds.Count == 0)
    {
        <MudAlert Severity="Severity.Warning">
            No Discord guild configurations found. Configure the bot in a guild first
            (<code>/config notifications #channel</code>) before creating templates.
        </MudAlert>
    }
    else
    {
        <MudPaper Class="pa-4" Elevation="2">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudSelect T="long" @bind-Value="_form.GuildId" Label="Discord guild" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var g in _guilds)
                        {
                            <MudSelectItem Value="@g.GuildId">@(string.IsNullOrEmpty(g.GuildName) ? g.GuildId.ToString() : g.GuildName)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField T="string" @bind-Value="_form.Name" Label="Template name" Required="true"
                                  Placeholder="e.g. Monday Raid"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField T="string" @bind-Value="_form.Description" Label="Description (sent in the embed)"
                                  Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int" @bind-Value="_form.DayOfWeek" Label="Day of week"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @for (int i = 0; i < 7; i++)
                        {
                            var dayValue = i;
                            <MudSelectItem Value="@dayValue">@DayNames[dayValue]</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTimePicker @bind-Time="_time" Label="Time" Required="true"
                                   AmPm="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="string" @bind-Value="_form.Timezone" Label="Timezone (IANA)" Required="true"
                               Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var tz in _timezones)
                        {
                            <MudSelectItem Value="@tz">@tz</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch T="bool" @bind-Value="_form.Active"
                               Label="Active (eligible for Post next)" Color="Color.Primary" />
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.h6" Class="mt-2 mb-1">Role slots</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Leave empty for a generic Accept / Reserve template. Spawned events snapshot
                        these slots at spawn time — edits affect future spawns; existing live events
                        only get the new slots if you re-click <strong>Post next</strong>.
                    </MudText>
                    @if (_form.RoleSlots.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-3">
                            No role slots — events will be Accept / Reserve only.
                        </MudAlert>
                    }
                    @foreach (var slot in _form.RoleSlots)
                    {
                        var captureSlot = slot;
                        <MudGrid Class="mb-1" Spacing="2">
                            <MudItem xs="8" md="6">
                                <MudTextField T="string" @bind-Value="captureSlot.Label"
                                              Label="Role label" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="3" md="2">
                                <MudNumericField T="int" @bind-Value="captureSlot.Count"
                                                 Label="Count" Min="1" Max="50"
                                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudItem>
                            <MudItem xs="1" md="1" Class="d-flex align-center">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error"
                                               OnClick="@(() => RemoveSlot(captureSlot))" />
                            </MudItem>
                        </MudGrid>
                    }
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddSlot" Class="mt-2">
                        Add slot
                    </MudButton>
                </MudItem>
            </MudGrid>

            <MudDivider Class="my-4" />

            <MudStack Row="true" Spacing="2" Justify="Justify.FlexEnd">
                <MudButton Href="/admin/events/templates">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save"
                           OnClick="SaveAsync" Disabled="@(_saving || !CanSave())">
                    @(_saving ? "Saving..." : "Save")
                </MudButton>
            </MudStack>
        </MudPaper>
    }
</AdminAuth>

@code {
    [Parameter] public Guid? Id { get; set; }

    private static readonly string[] DayNames = { "Sunday", "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday" };

    // Common IANA zones the dropdown offers; the browser's local zone is auto-inserted
    // at the top if not already present, so users almost always have their zone in reach.
    private static readonly string[] BaseTimezones = new[]
    {
        "UTC",
        "America/New_York", "America/Chicago", "America/Denver",
        "America/Los_Angeles", "America/Anchorage", "Pacific/Honolulu",
        "Europe/London", "Europe/Berlin", "Europe/Moscow",
        "Asia/Dubai", "Asia/Kolkata", "Asia/Shanghai", "Asia/Tokyo",
        "Australia/Sydney"
    };

    private bool _isNew => Id == null;
    private bool _loading = true;
    private bool _saving = false;
    private TimeSpan? _time = new TimeSpan(19, 0, 0);
    private List<GuildOption> _guilds = new();
    private List<string> _timezones = new();
    private FormModel _form = new();

    protected override async Task OnInitializedAsync()
    {
        _timezones = new List<string>(BaseTimezones);
        var local = TimeZoneInfo.Local.Id;
        if (!_timezones.Contains(local)) _timezones.Insert(0, local);
        _form.Timezone = local;

        try
        {
            _guilds = await Http.GetFromJsonAsync<List<GuildOption>>("api/admin/bot-config") ?? new();
            if (_guilds.Count == 1) _form.GuildId = _guilds[0].GuildId;

            if (Id.HasValue)
            {
                var t = await Http.GetFromJsonAsync<TemplateResp>($"api/admin/event-templates/{Id}");
                if (t != null)
                {
                    _form.GuildId = t.GuildId;
                    _form.Name = t.Name;
                    _form.Description = t.Description;
                    _form.DayOfWeek = t.DayOfWeek;
                    _form.Timezone = t.Timezone;
                    if (!_timezones.Contains(t.Timezone)) _timezones.Insert(0, t.Timezone);
                    _form.Active = t.Active;
                    _form.RoleSlots = t.RoleSlots?
                        .Select(s => new SlotEditRow { Id = s.Id, Label = s.Label, Count = s.Count })
                        .ToList() ?? new();
                    if (TimeSpan.TryParse(t.TimeOfDay, out var ts)) _time = ts;
                }
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to load template", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool CanSave() => _form.GuildId != 0
                              && !string.IsNullOrWhiteSpace(_form.Name)
                              && !string.IsNullOrWhiteSpace(_form.Timezone)
                              && _time.HasValue;

    private void AddSlot() => _form.RoleSlots.Add(new SlotEditRow
    {
        Id = Guid.NewGuid().ToString("N").Substring(0, 8),
        Label = "",
        Count = 1
    });

    private void RemoveSlot(SlotEditRow slot) => _form.RoleSlots.Remove(slot);

    private async Task SaveAsync()
    {
        if (!CanSave()) return;
        _saving = true;
        try
        {
            var slots = _form.RoleSlots
                .Where(s => !string.IsNullOrWhiteSpace(s.Label) && s.Count > 0)
                .Select(s => new RoleSlot(s.Id, s.Label.Trim(), s.Count))
                .ToList();

            var body = new
            {
                GuildId = _form.GuildId,
                Name = _form.Name.Trim(),
                Description = string.IsNullOrWhiteSpace(_form.Description) ? null : _form.Description.Trim(),
                DayOfWeek = _form.DayOfWeek,
                TimeOfDay = _time!.Value.ToString(@"hh\:mm\:ss"),
                Timezone = _form.Timezone,
                RoleSlots = slots,
                Active = _form.Active
            };

            var resp = _isNew
                ? await Http.PostAsJsonAsync("api/admin/event-templates", body)
                : await Http.PutAsJsonAsync($"api/admin/event-templates/{Id}", body);

            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add(_isNew ? "Template created" : "Template saved", Severity.Success);
                Nav.NavigateTo("/admin/events/templates");
            }
            else
            {
                Snackbar.Add("Failed to save template", Severity.Error);
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to save template", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private class FormModel
    {
        public long GuildId { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public int DayOfWeek { get; set; } = 1; // Monday default
        public string Timezone { get; set; } = "UTC";
        public bool Active { get; set; } = true;
        public List<SlotEditRow> RoleSlots { get; set; } = new();
    }

    private class SlotEditRow
    {
        public string Id { get; set; } = "";
        public string Label { get; set; } = "";
        public int Count { get; set; } = 1;
    }

    public record GuildOption(long GuildId, string? GuildName);

    public record TemplateResp(
        Guid Id, long GuildId, string Name, string? Description,
        int DayOfWeek, string TimeOfDay, string Timezone,
        List<RoleSlot>? RoleSlots, bool Active, DateTimeOffset? NextOccurrence);
}
