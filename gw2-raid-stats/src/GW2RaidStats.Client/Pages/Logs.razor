@page "/logs"
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>GW2 Raid Stats - Logs</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Encounter Logs</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" />
        <MudText Typo="Typo.h6">Filters</MudText>
        <MudSpacer />
        <MudToggleGroup T="string" Value="_contentType" ValueChanged="OnContentTypeChanged" Color="Color.Primary" CheckMark="false">
            <MudToggleItem Value="@("raids")" Text="Raids" />
            <MudToggleItem Value="@("strikes")" Text="Strikes" />
        </MudToggleGroup>
    </MudStack>

    <MudGrid Spacing="2">
        @if (_contentType == "raids")
        {
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int?"
                           Label="Wing"
                           Value="_wingFilter"
                           ValueChanged="OnWingFilterChanged"
                           Clearable="true"
                           Variant="Variant.Outlined"
                           Dense="true">
                    @foreach (var wing in _availableWings)
                    {
                        <MudSelectItem Value="@((int?)wing)">Wing @wing - @GetWingName(wing)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        }
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string"
                       Label="Boss"
                       @bind-Value="_bossNameFilter"
                       Clearable="true"
                       Variant="Variant.Outlined"
                       Dense="true"
                       MaxHeight="300">
                @foreach (var boss in FilteredBosses)
                {
                    <MudSelectItem Value="@boss.Name">
                        @if (_contentType == "raids" && _wingFilter == null)
                        {
                            <span>W@(boss.Wing) - @boss.Name</span>
                        }
                        else
                        {
                            @boss.Name
                        }
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudSelect T="bool?" Label="Mode" @bind-Value="_isCMFilter" Clearable="true" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="@((bool?)false)">Normal</MudSelectItem>
                <MudSelectItem Value="@((bool?)true)">CM</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="4" md="2">
            <MudSelect T="bool?" Label="Result" @bind-Value="_successFilter" Clearable="true" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="@((bool?)true)">Kill</MudSelectItem>
                <MudSelectItem Value="@((bool?)false)">Wipe</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="4" md="2">
            <MudTextField @bind-Value="_recordedByFilter"
                          Label="Recorded By"
                          Variant="Variant.Outlined"
                          Dense="true"
                          Clearable="true" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker Label="From"
                           @bind-Date="_fromDate"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Clearable="true" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudDatePicker Label="To"
                           @bind-Date="_toDate"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Clearable="true" />
        </MudItem>
        <MudItem xs="12" md="4">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Style="height: 100%;">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchLogs">
                    Search
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearFilters">
                    Clear
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4" Elevation="2">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    @if (_searchResult == null || _searchResult.Logs.Count == 0)
    {
        @if (!_loading)
        {
            <MudAlert Severity="Severity.Info">No logs found. Try adjusting your filters.</MudAlert>
        }
    }
    else
    {
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap" Spacing="2">
            <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                Found @_searchResult.TotalCount.ToString("N0") logs
            </MudText>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-none d-sm-block">Page size:</MudText>
                <MudSelect T="int" Value="_pageSize" ValueChanged="OnPageSizeChanged" Dense="true" Style="width: 70px;" Variant="Variant.Outlined">
                    <MudSelectItem Value="10">10</MudSelectItem>
                    <MudSelectItem Value="25">25</MudSelectItem>
                    <MudSelectItem Value="50">50</MudSelectItem>
                    <MudSelectItem Value="100">100</MudSelectItem>
                </MudSelect>
            </MudStack>
        </MudStack>

        <MudTable Items="@_searchResult.Logs"
                  Dense="true"
                  Hover="true"
                  Striped="true"
                  Loading="@_loading"
                  LoadingProgressColor="Color.Primary"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh Class="d-none d-md-table-cell" Style="width: 50px;"></MudTh>
                <MudTh>Boss</MudTh>
                <MudTh>Result</MudTh>
                <MudTh Class="d-none d-sm-table-cell">Duration</MudTh>
                <MudTh>Date</MudTh>
                <MudTh Class="d-none d-lg-table-cell">Recorded By</MudTh>
                <MudTh>Log</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="" Class="d-none d-md-table-cell">
                    @if (!string.IsNullOrEmpty(context.IconUrl))
                    {
                        <MudAvatar Size="Size.Small">
                            <MudImage Src="@context.IconUrl" Alt="@context.BossName" />
                        </MudAvatar>
                    }
                </MudTd>
                <MudTd DataLabel="Boss">
                    <MudStack Spacing="0">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                            <MudLink Href="@($"/bosses/{context.TriggerId}?isCM={context.IsCM}")" Style="word-break: break-word;">
                                @context.BossName
                            </MudLink>
                            @if (context.IsCM)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">CM</MudChip>
                            }
                            @if (context.IsLegendaryCM)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">LCM</MudChip>
                            }
                        </MudStack>
                        @if (context.Wing.HasValue)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Wing @context.Wing</MudText>
                        }
                    </MudStack>
                </MudTd>
                <MudTd DataLabel="Result">
                    @if (context.Success)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Kill</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error">Wipe</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Duration" Class="d-none d-sm-table-cell">@FormatDuration(context.DurationSeconds)</MudTd>
                <MudTd DataLabel="Date">
                    <MudText Typo="Typo.body2">@context.EncounterTime.LocalDateTime.ToString("MMM d")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.EncounterTime.LocalDateTime.ToString("HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Recorded By" Class="d-none d-lg-table-cell">@(context.RecordedBy ?? "-")</MudTd>
                <MudTd DataLabel="Log">
                    <MudStack Row="true" Spacing="0">
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                       Size="Size.Small"
                                       Href="@($"/api/reports/{context.Id}/view")"
                                       Target="_blank"
                                       Title="View HTML Report" />
                        <MudIconButton Icon="@Icons.Material.Filled.Download"
                                       Size="Size.Small"
                                       Href="@($"/api/reports/{context.Id}/download")"
                                       Target="_blank"
                                       Title="Download .zevtc" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_searchResult.TotalPages > 1)
        {
            <MudStack Row="true" Justify="Justify.Center" Class="mt-4">
                <MudPagination Count="@_searchResult.TotalPages"
                               Selected="@(_currentPage + 1)"
                               SelectedChanged="OnPageChanged"
                               Color="Color.Primary"
                               ShowFirstButton="true"
                               ShowLastButton="true" />
            </MudStack>
        }
    }
</MudPaper>

@code {
    private bool _loading = true;
    private LogSearchResultDto? _searchResult;
    private List<int> _availableWings = new() { 1, 2, 3, 4, 5, 6, 7, 8 };

    // Content type: "raids" or "strikes"
    private string _contentType = "raids";

    // Static boss data with wing information (raids)
    private static readonly List<BossInfo> RaidBosses = new()
    {
        // Wing 1
        new(1, "Vale Guardian"),
        new(1, "Gorseval the Multifarious"),
        new(1, "Sabetha the Saboteur"),
        // Wing 2
        new(2, "Slothasor"),
        new(2, "Matthias Gabrel"),
        // Wing 3
        new(3, "Keep Construct"),
        new(3, "Xera"),
        // Wing 4
        new(4, "Cairn the Indomitable"),
        new(4, "Mursaat Overseer"),
        new(4, "Samarog"),
        new(4, "Deimos"),
        // Wing 5
        new(5, "Soulless Horror"),
        new(5, "Dhuum"),
        // Wing 6
        new(6, "Conjured Amalgamate"),
        new(6, "Twin Largos"),
        new(6, "Qadim"),
        // Wing 7
        new(7, "Cardinal Adina"),
        new(7, "Cardinal Sabir"),
        new(7, "Qadim the Peerless"),
        // Wing 8 (NM)
        new(8, "Greer"),
        new(8, "Decima"),
        new(8, "Ura"),
        // Wing 8 (CM)
        new(8, "Massive Greer"),
        new(8, "Godsquall Decima"),
        new(8, "Ura the Adorned"),
    };

    // Strike bosses (no wing)
    private static readonly List<string> StrikeBosses = new()
    {
        // IBS Strikes
        "Shiverpeaks Pass",
        "Voice of the Fallen and Claw of the Fallen",
        "Fraenir of Jormag",
        "Boneskinner",
        "Whisper of Jormag",
        "Cold War",
        // EoD Strikes
        "Aetherblade Hideout",
        "Xunlai Jade Junkyard",
        "Kaineng Overlook",
        "Harvest Temple",
        // SotO Strikes
        "Old Lion's Court",
        "Cosmic Observatory",
        "Temple of Febe",
        // JW Strikes
        "Guardian's Glade"
    };

    private IEnumerable<BossInfo> FilteredBosses => _contentType == "raids"
        ? (_wingFilter.HasValue ? RaidBosses.Where(b => b.Wing == _wingFilter.Value) : RaidBosses)
        : StrikeBosses.Select(name => new BossInfo(0, name));

    // Filter values
    private string? _bossNameFilter;
    private int? _wingFilter;
    private bool? _isCMFilter;
    private bool? _successFilter;
    private string? _recordedByFilter;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    // Pagination
    private int _currentPage = 0;
    private int _pageSize = 25;

    protected override async Task OnInitializedAsync()
    {
        await SearchLogs();
    }

    private void OnContentTypeChanged(string value)
    {
        _contentType = value;
        // Clear filters when switching content type
        _wingFilter = null;
        _bossNameFilter = null;
    }

    private void OnWingFilterChanged(int? value)
    {
        _wingFilter = value;
        // Clear boss filter if it's not in the new wing
        if (_wingFilter.HasValue && !string.IsNullOrEmpty(_bossNameFilter))
        {
            var bossInWing = RaidBosses.Any(b => b.Wing == _wingFilter.Value && b.Name == _bossNameFilter);
            if (!bossInWing)
            {
                _bossNameFilter = null;
            }
        }
    }

    private static string GetWingName(int wing) => wing switch
    {
        1 => "Spirit Vale",
        2 => "Salvation Pass",
        3 => "Stronghold",
        4 => "Bastion",
        5 => "Hall of Chains",
        6 => "Mythwright",
        7 => "Ahdashim",
        8 => "Mt. Balrior",
        _ => ""
    };

    private async Task SearchLogs()
    {
        _loading = true;
        _currentPage = 0;
        await LoadLogsAsync();
    }

    private async Task LoadLogsAsync()
    {
        _loading = true;
        try
        {
            var queryParams = new List<string>
            {
                $"page={_currentPage}",
                $"pageSize={_pageSize}"
            };

            if (!string.IsNullOrWhiteSpace(_bossNameFilter))
                queryParams.Add($"bossName={Uri.EscapeDataString(_bossNameFilter)}");
            if (_contentType == "strikes")
                queryParams.Add("isStrike=true");
            else if (_wingFilter.HasValue)
                queryParams.Add($"wing={_wingFilter.Value}");
            else
                queryParams.Add("isStrike=false"); // Raids only when no specific wing selected
            if (_isCMFilter.HasValue)
                queryParams.Add($"isCM={_isCMFilter.Value}");
            if (_successFilter.HasValue)
                queryParams.Add($"success={_successFilter.Value}");
            if (!string.IsNullOrWhiteSpace(_recordedByFilter))
                queryParams.Add($"recordedBy={Uri.EscapeDataString(_recordedByFilter)}");
            if (_fromDate.HasValue)
                queryParams.Add($"fromDate={_fromDate.Value:yyyy-MM-dd}");
            if (_toDate.HasValue)
                queryParams.Add($"toDate={_toDate.Value:yyyy-MM-dd}");

            var url = $"api/logs?{string.Join("&", queryParams)}";
            _searchResult = await Http.GetFromJsonAsync<LogSearchResultDto>(url);
        }
        catch
        {
            _searchResult = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClearFilters()
    {
        _contentType = "raids";
        _bossNameFilter = null;
        _wingFilter = null;
        _isCMFilter = null;
        _successFilter = null;
        _recordedByFilter = null;
        _fromDate = null;
        _toDate = null;
        _currentPage = 0;
        await LoadLogsAsync();
    }

    private async Task OnPageChanged(int page)
    {
        _currentPage = page - 1; // MudPagination is 1-based
        await LoadLogsAsync();
    }

    private async Task OnPageSizeChanged(int newSize)
    {
        _pageSize = newSize;
        _currentPage = 0;
        await LoadLogsAsync();
    }

    private string FormatDuration(double seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return ts.TotalMinutes >= 1
            ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}"
            : $"{ts.Seconds}s";
    }

    // DTOs
    public record LogSearchResultDto(
        List<LogEntryDto> Logs,
        int TotalCount,
        int Page,
        int PageSize,
        int TotalPages
    );

    public record LogEntryDto(
        Guid Id,
        int TriggerId,
        string BossName,
        int? Wing,
        bool IsCM,
        bool IsLegendaryCM,
        bool Success,
        double DurationSeconds,
        DateTimeOffset EncounterTime,
        string? RecordedBy,
        string? LogUrl,
        string? IconUrl
    );

    public record BossInfo(int Wing, string Name);
}
