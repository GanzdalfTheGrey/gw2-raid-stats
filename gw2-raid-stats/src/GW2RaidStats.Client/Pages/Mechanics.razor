@page "/mechanics"
@inject HttpClient Http

<PageTitle>GW2 Raid Stats - Mechanics</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Mechanic Lookup</MudText>

<MudPaper Class="pa-4 mb-4" Elevation="2">
    <MudText Typo="Typo.h6" Class="mb-3">
        <MudIcon Icon="@Icons.Material.Filled.FilterList" Class="mr-2" />
        Search
    </MudText>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6" md="3">
            <MudSelect T="string"
                       Label="Boss"
                       Value="_bossFilter"
                       ValueChanged="OnBossFilterChanged"
                       Clearable="true"
                       Variant="Variant.Outlined"
                       Dense="true"
                       MaxHeight="300">
                @foreach (var boss in AvailableBosses)
                {
                    <MudSelectItem Value="@boss">@boss</MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudAutocomplete T="MechanicInfoDto"
                             Label="Mechanic"
                             @bind-Value="_selectedMechanic"
                             SearchFunc="SearchMechanics"
                             ToStringFunc="@(m => m?.MechanicFullName ?? m?.MechanicName ?? "")"
                             Clearable="true"
                             Variant="Variant.Outlined"
                             Dense="true"
                             ResetValueOnEmptyText="true"
                             ShowProgressIndicator="true">
                <ItemTemplate Context="mechanic">
                    <MudStack Spacing="0">
                        <MudText>@(mechanic.MechanicFullName ?? mechanic.MechanicName)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @(mechanic.BossName ?? "Unknown") - @mechanic.TotalCount.ToString("N0") total
                        </MudText>
                    </MudStack>
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudDatePicker Label="From"
                           @bind-Date="_fromDate"
                           Variant="Variant.Outlined"
                           Clearable="true" />
        </MudItem>
        <MudItem xs="6" sm="3" md="2">
            <MudDatePicker Label="To"
                           @bind-Date="_toDate"
                           Variant="Variant.Outlined"
                           Clearable="true" />
        </MudItem>
        <MudItem xs="12" lg="2">
            <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.FlexStart" Style="height: 100%;">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="SearchAsync"
                           Disabled="_selectedMechanic == null"
                           Style="min-width: 90px;">
                    Search
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Clear"
                           OnClick="ClearFilters"
                           Style="min-width: 80px;">
                    Clear
                </MudButton>
            </MudStack>
        </MudItem>
    </MudGrid>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

@if (_searchResult != null)
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudStack Row="false" Spacing="2" Class="mb-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2">
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Style="word-break: break-word;">@(_searchResult.MechanicFullName ?? _searchResult.MechanicName)</MudText>
                    @if (!string.IsNullOrEmpty(_searchResult.BossName))
                    {
                        var wikiUrl = GetWikiUrl(_searchResult.BossName);
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Boss:</MudText>
                            @if (wikiUrl != null)
                            {
                                <MudLink Href="@wikiUrl" Target="_blank" Typo="Typo.body2">
                                    @_searchResult.BossName
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Style="font-size: 0.8rem; vertical-align: middle;" />
                                </MudLink>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@_searchResult.BossName</MudText>
                            }
                        </MudStack>
                    }
                </MudStack>
                <MudChip T="string" Color="Color.Primary" Size="Size.Medium">
                    @_searchResult.TotalCount.ToString("N0") total
                </MudChip>
            </MudStack>
            @if (!string.IsNullOrEmpty(_searchResult.Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@_searchResult.Description</MudText>
            }
        </MudStack>

        @if (_searchResult.PlayerStats.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No player data found for this mechanic in the selected date range.</MudAlert>
        }
        else
        {
            <MudTable Items="@_searchResult.PlayerStats"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Rank</MudTh>
                    <MudTh>Player</MudTh>
                    <MudTh>Count</MudTh>
                    <MudTh Class="d-none d-sm-table-cell">Share</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Rank">
                        @GetRank(context)
                    </MudTd>
                    <MudTd DataLabel="Player">
                        <MudLink Href="@($"/players/{Uri.EscapeDataString(context.AccountName)}")">
                            @context.AccountName
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="Count">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                            <MudText>@context.Count.ToString("N0")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-sm-none">
                                (@GetPercentage(context).ToString("F1")%)
                            </MudText>
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Share" Class="d-none d-sm-table-cell">
                        <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Style="min-width: 120px;">
                            <MudProgressLinear Color="Color.Primary"
                                               Value="@GetPercentage(context)"
                                               Style="height: 16px; border-radius: 4px; flex: 1;" />
                            <MudText Typo="Typo.caption" Style="min-width: 45px;">
                                @GetPercentage(context).ToString("F1")%
                            </MudText>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}
else if (!_loading && _hasSearched)
{
    <MudAlert Severity="Severity.Info">Select a mechanic and click Search to see results.</MudAlert>
}
else if (!_loading)
{
    <MudPaper Class="pa-4" Elevation="2">
        <MudText Typo="Typo.h6" Class="mb-3">
            Available Mechanics
            @if (!string.IsNullOrEmpty(_bossFilter))
            {
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary" Style="display: inline;"> - @_bossFilter</MudText>
            }
        </MudText>
        @if (_allMechanics.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No mechanics found. Import some logs to see mechanics data.</MudAlert>
        }
        else if (!FilteredMechanics.Any())
        {
            <MudAlert Severity="Severity.Info">No mechanics found for this boss.</MudAlert>
        }
        else
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                @FilteredMechanics.Count() mechanics@(string.IsNullOrEmpty(_bossFilter) ? " tracked across all encounters" : $" for {_bossFilter}"). Select one above to search.
            </MudText>
            <MudTable Items="@FilteredMechanics.Take(20)"
                      T="MechanicInfoDto"
                      Dense="true"
                      Hover="true"
                      Striped="true"
                      Breakpoint="Breakpoint.Sm"
                      OnRowClick="@(args => SelectMechanic(args.Item))">
                <HeaderContent>
                    <MudTh>Mechanic</MudTh>
                    <MudTh Class="d-none d-sm-table-cell">Boss</MudTh>
                    <MudTh Class="d-none d-lg-table-cell">Description</MudTh>
                    <MudTh>Count</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Mechanic">
                        <MudStack Spacing="0">
                            <MudText Style="word-break: break-word;">@(context.MechanicFullName ?? context.MechanicName)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.MechanicName</MudText>
                            @if (!string.IsNullOrEmpty(context.BossName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="d-sm-none">
                                    @context.BossName
                                </MudText>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Boss" Class="d-none d-sm-table-cell">
                        @if (!string.IsNullOrEmpty(context.BossName))
                        {
                            var wikiUrl = GetWikiUrl(context.BossName);
                            @if (wikiUrl != null)
                            {
                                <MudLink Href="@wikiUrl" Target="_blank" Typo="Typo.body2">
                                    @context.BossName
                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Style="font-size: 0.8rem; vertical-align: middle;" />
                                </MudLink>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@context.BossName</MudText>
                            }
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">-</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Description" Class="d-none d-lg-table-cell">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@(context.Description ?? "-")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Count">
                        <MudChip T="string" Size="Size.Small" Color="Color.Default">@context.TotalCount.ToString("N0")</MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (FilteredMechanics.Count() > 20)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">
                    Showing top 20 of @FilteredMechanics.Count() mechanics. Use the search above to find others.
                </MudText>
            }
        }
    </MudPaper>
}

@code {
    private bool _loading = true;
    private bool _hasSearched = false;
    private List<MechanicInfoDto> _allMechanics = new();
    private MechanicInfoDto? _selectedMechanic;
    private string? _bossFilter;
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private MechanicSearchResultDto? _searchResult;

    // Get unique boss names for the filter dropdown
    private IEnumerable<string> AvailableBosses => _allMechanics
        .Where(m => !string.IsNullOrEmpty(m.BossName))
        .Select(m => m.BossName!)
        .Distinct()
        .OrderBy(b => b);

    // Filter mechanics by boss for the table
    private IEnumerable<MechanicInfoDto> FilteredMechanics => string.IsNullOrEmpty(_bossFilter)
        ? _allMechanics
        : _allMechanics.Where(m => m.BossName == _bossFilter);

    protected override async Task OnInitializedAsync()
    {
        await LoadMechanicsAsync();
    }

    private async Task LoadMechanicsAsync()
    {
        _loading = true;
        try
        {
            _allMechanics = await Http.GetFromJsonAsync<List<MechanicInfoDto>>("api/mechanics") ?? new();
        }
        catch
        {
            _allMechanics = new();
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnBossFilterChanged(string? value)
    {
        _bossFilter = value;
        // Clear selected mechanic if it's not from the selected boss
        if (!string.IsNullOrEmpty(_bossFilter) && _selectedMechanic != null && _selectedMechanic.BossName != _bossFilter)
        {
            _selectedMechanic = null;
        }
    }

    private Task<IEnumerable<MechanicInfoDto>> SearchMechanics(string value, CancellationToken ct)
    {
        var mechanics = string.IsNullOrEmpty(_bossFilter)
            ? _allMechanics
            : _allMechanics.Where(m => m.BossName == _bossFilter);

        if (string.IsNullOrEmpty(value))
            return Task.FromResult(mechanics.Take(20));

        var results = mechanics
            .Where(m =>
                (m.MechanicName?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.MechanicFullName?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (m.Description?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false))
            .Take(20);

        return Task.FromResult(results);
    }

    private void SelectMechanic(MechanicInfoDto mechanic)
    {
        _selectedMechanic = mechanic;
    }

    private async Task SearchAsync()
    {
        if (_selectedMechanic == null) return;

        _loading = true;
        _hasSearched = true;
        _searchResult = null;

        try
        {
            var queryParams = new List<string>
            {
                $"mechanicName={Uri.EscapeDataString(_selectedMechanic.MechanicName)}"
            };

            if (_fromDate.HasValue)
                queryParams.Add($"fromDate={_fromDate.Value:yyyy-MM-dd}");
            if (_toDate.HasValue)
                queryParams.Add($"toDate={_toDate.Value:yyyy-MM-dd}");

            var url = $"api/mechanics/search?{string.Join("&", queryParams)}";
            _searchResult = await Http.GetFromJsonAsync<MechanicSearchResultDto>(url);
        }
        catch
        {
            _searchResult = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ClearFilters()
    {
        _selectedMechanic = null;
        _bossFilter = null;
        _fromDate = null;
        _toDate = null;
        _searchResult = null;
        _hasSearched = false;
    }

    private int GetRank(MechanicPlayerStatDto player)
    {
        return _searchResult?.PlayerStats.IndexOf(player) + 1 ?? 0;
    }

    private double GetPercentage(MechanicPlayerStatDto player)
    {
        if (_searchResult == null || _searchResult.TotalCount == 0) return 0;
        return (double)player.Count / _searchResult.TotalCount * 100;
    }

    private static string? GetWikiUrl(string? bossName)
    {
        if (string.IsNullOrEmpty(bossName)) return null;

        // Map boss names to their wiki page names
        var wikiName = bossName switch
        {
            "Vale Guardian" => "Vale_Guardian",
            "Gorseval the Multifarious" => "Gorseval_the_Multifarious",
            "Sabetha the Saboteur" => "Sabetha_the_Saboteur",
            "Slothasor" => "Slothasor",
            "Matthias Gabrel" => "Matthias_Gabrel",
            "Keep Construct" => "Keep_Construct",
            "Xera" => "Xera",
            "Cairn the Indomitable" => "Cairn_the_Indomitable",
            "Mursaat Overseer" => "Mursaat_Overseer",
            "Samarog" => "Samarog",
            "Deimos" => "Deimos_(raid)",
            "Soulless Horror" => "Soulless_Horror",
            "Desmina" => "Soulless_Horror",
            "Dhuum" => "Dhuum",
            "Conjured Amalgamate" => "Conjured_Amalgamate",
            "Twin Largos" => "Twin_Largos",
            "Nikare" => "Twin_Largos",
            "Kenut" => "Twin_Largos",
            "Qadim" => "Qadim",
            "Cardinal Adina" => "Cardinal_Adina",
            "Cardinal Sabir" => "Cardinal_Sabir",
            "Qadim the Peerless" => "Qadim_the_Peerless",
            "Greer" or "Greer, the Blightbringer" or "Massive Greer" => "Greer,_the_Blightbringer",
            "Decima" or "Decima, the Stormsinger" or "Godsquall Decima" => "Decima,_the_Stormsinger",
            "Ura" or "Ura, the Drowning" or "Ura the Adorned" => "Ura,_the_Drowning",
            _ => bossName.Replace(" ", "_")
        };

        return $"https://wiki.guildwars2.com/wiki/{wikiName}";
    }

    // DTOs
    public record MechanicInfoDto(
        string MechanicName,
        string? MechanicFullName,
        string? Description,
        int TotalCount,
        string? BossName
    );

    public record MechanicSearchResultDto(
        string MechanicName,
        string? MechanicFullName,
        string? Description,
        string? BossName,
        DateTimeOffset? FromDate,
        DateTimeOffset? ToDate,
        int TotalCount,
        List<MechanicPlayerStatDto> PlayerStats
    );

    public record MechanicPlayerStatDto(
        string AccountName,
        int Count
    );
}
