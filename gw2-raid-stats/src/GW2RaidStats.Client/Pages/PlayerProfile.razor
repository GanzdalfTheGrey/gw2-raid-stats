@page "/players/{AccountName}"
@inject HttpClient Http
@inject NavigationManager Navigation
@using System.Text.Json

<PageTitle>GW2 Raid Stats - @(_profile?.AccountName ?? "Player")</PageTitle>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_profile == null)
{
    <MudAlert Severity="Severity.Error">Player not found.</MudAlert>
}
else
{
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <MudText Typo="Typo.h4">@_profile.AccountName</MudText>
        <MudStack Row="true" Spacing="2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Insights"
                       Href="@($"/player/{_profile.Id}/recap")">
                View Recap
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Category"
                       Href="@($"/players/{_profile.AccountName}/specs")">
                Spec History
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Tertiary"
                       StartIcon="@Icons.Material.Filled.WorkspacePremium"
                       Href="@($"/players/{_profile.AccountName}/roles")">
                Roles
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.TrendingUp"
                       Href="@($"/players/{_profile.AccountName}/trends")">
                Trends
            </MudButton>
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
                Back to Players
            </MudButton>
        </MudStack>
    </MudStack>

    <MudGrid>
        @* Overview Card *@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="mr-2" />
                    Overview
                </MudText>
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Color="Color.Secondary">First Seen</MudText>
                        <MudText>@_profile.FirstSeen.LocalDateTime.ToString("MMM d, yyyy")</MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Color="Color.Secondary">Total Encounters</MudText>
                        <MudText><strong>@_profile.TotalEncounters.ToString("N0")</strong></MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Color="Color.Secondary">Total Kills</MudText>
                        <MudText Color="Color.Success"><strong>@_profile.TotalKills.ToString("N0")</strong></MudText>
                    </MudStack>
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Color="Color.Secondary">Success Rate</MudText>
                        <MudText Color="@(GetSuccessRateColor(_profile.SuccessRate))">
                            <strong>@_profile.SuccessRate.ToString("F1")%</strong>
                        </MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        </MudItem>

        @* Favorite Class Card *@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Star" Class="mr-2" />
                    Favorite Class
                </MudText>
                @if (_profile.FavoriteClass != null)
                {
                    <MudStack Spacing="2">
                        <MudText Typo="Typo.h5" Color="Color.Primary">@_profile.FavoriteClass</MudText>
                        @foreach (var cls in _profile.ClassBreakdown.Take(5))
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudText Typo="Typo.body2">@cls.Profession</MudText>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2">@cls.Count</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">(@cls.Percentage.ToString("F0")%)</MudText>
                                </MudStack>
                            </MudStack>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Color="Color.Secondary">No data</MudText>
                }
            </MudPaper>
        </MudItem>

        @* Favorite Role Card *@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Class="mr-2" />
                    Favorite Role
                </MudText>
                @if (_profile.FavoriteRole != null)
                {
                    <MudStack Spacing="2">
                        <MudChip T="string" Color="@GetRoleColor(_profile.FavoriteRole)" Size="Size.Large">
                            @_profile.FavoriteRole
                        </MudChip>
                        @foreach (var role in _profile.RoleBreakdown)
                        {
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(role.Role)">@role.Role</MudChip>
                                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2">@role.Count</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">(@role.Percentage.ToString("F0")%)</MudText>
                                </MudStack>
                            </MudStack>
                        }
                    </MudStack>
                }
                else
                {
                    <MudText Color="Color.Secondary">No data</MudText>
                }
            </MudPaper>
        </MudItem>

        @* Achievements Card *@
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.MilitaryTech" Class="mr-2" />
                        Achievements
                    </MudText>
                    <MudLink Href="@($"/players/{Uri.EscapeDataString(AccountName)}/achievements")">View All</MudLink>
                </MudStack>
                @if (_loadingAchievements)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (_achievements != null)
                {
                    <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="mb-3">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Large">
                            @_achievements.TotalEarned / @_achievements.TotalAvailable Earned
                        </MudChip>
                    </MudStack>

                    @if (_achievements.Earned.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Recent Achievements</MudText>
                        <MudStack Spacing="2">
                            @foreach (var achievement in _achievements.Earned.Take(5))
                            {
                                <MudPaper Class="pa-2" Elevation="0" Style="background-color: var(--mud-palette-background-gray);">
                                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start">
                                        <MudStack Spacing="0">
                                            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                                <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Size="Size.Small" Color="Color.Warning" />
                                                <MudText><strong>@achievement.Name</strong></MudText>
                                                @if (TryGetEncounterId(achievement.Context, out var encounterId))
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                                   Size="Size.Small"
                                                                   Href="@($"/api/reports/{encounterId}/view")"
                                                                   Target="_blank" />
                                                }
                                            </MudStack>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-7">
                                                @achievement.Description
                                            </MudText>
                                        </MudStack>
                                        <MudStack Spacing="0" AlignItems="AlignItems.End">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @achievement.AchievedAt.LocalDateTime.ToString("MMM d, yyyy")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                                @achievement.EarnedCount / @achievement.TotalIncludedPlayers players
                                            </MudText>
                                        </MudStack>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true">No achievements earned yet. Keep raiding!</MudAlert>
                    }

                    @if (_achievements.InProgress.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">In Progress</MudText>
                        <MudStack Spacing="1">
                            @foreach (var progress in _achievements.InProgress.Take(3))
                            {
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.body2">@progress.Name</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@progress.ProgressText</MudText>
                                </MudStack>
                                <MudProgressLinear Value="@progress.Current" Max="@progress.Required" Color="Color.Info" Class="mb-2" />
                            }
                        </MudStack>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No achievement data available.</MudAlert>
                }
            </MudPaper>
        </MudItem>

        @* Boon Coverage Card *@
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Class="mr-2" />
                        Boon Coverage
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Generation = your sub's avg uptime when you were the booner. Self = your own uptime when someone else booned.
                    </MudText>
                </MudStack>
                @if (_boonCoverage == null)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else
                {
                    @* Headline summary above the tabs — both Gen and Self for both boons *@
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            @RenderBoonHeadline("Quickness", _boonCoverage.Quickness)
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @RenderBoonHeadline("Alacrity", _boonCoverage.Alacrity)
                        </MudItem>
                    </MudGrid>

                    @* Generation / Self breakdown lives in tabs so each side gets full width *@
                    <MudTabs Outlined="false" Rounded="true" Border="false" Position="Position.Top" Class="mt-3" PanelClass="pa-0 pt-3">
                        <MudTabPanel Text="As Generator" Icon="@Icons.Material.Filled.Bolt">
                            @RenderBoonBreakdown(_boonCoverage, BoonSlice.Generation)
                        </MudTabPanel>
                        <MudTabPanel Text="On Myself" Icon="@Icons.Material.Filled.Shield">
                            @RenderBoonBreakdown(_boonCoverage, BoonSlice.Self)
                        </MudTabPanel>
                    </MudTabs>
                }
            </MudPaper>
        </MudItem>

        @* Personal Bests *@
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.EmojiEvents" Class="mr-2" />
                        Personal Bests
                    </MudText>
                    <MudToggleGroup T="string" @bind-Value="_personalBestSort" Color="Color.Primary" Size="Size.Small">
                        <MudToggleItem Value="@("wing")" Text="By Wing" />
                        <MudToggleItem Value="@("dps")" Text="By DPS" />
                    </MudToggleGroup>
                </MudStack>
                @if (_profile.PersonalBests.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No kills recorded yet.</MudAlert>
                }
                else
                {
                    <MudTable Items="@SortedPersonalBests"
                              Dense="true"
                              Hover="true"
                              Striped="true">
                        <HeaderContent>
                            <MudTh>Boss</MudTh>
                            <MudTh>Mode</MudTh>
                            <MudTh>DPS</MudTh>
                            <MudTh>Class</MudTh>
                            <MudTh>Character</MudTh>
                            <MudTh>Kills</MudTh>
                            <MudTh>Date</MudTh>
                            <MudTh>Log</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Boss">@context.BossName</MudTd>
                            <MudTd DataLabel="Mode">
                                <MudChip T="string" Size="Size.Small" Color="@(context.IsCM ? Color.Warning : Color.Default)">
                                    @(context.IsCM ? "CM" : "NM")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="DPS">
                                <MudText Color="Color.Error"><strong>@context.Dps.ToString("N0")</strong></MudText>
                            </MudTd>
                            <MudTd DataLabel="Class">@context.Profession</MudTd>
                            <MudTd DataLabel="Character">@context.CharacterName</MudTd>
                            <MudTd DataLabel="Kills">@context.KillCount</MudTd>
                            <MudTd DataLabel="Date">@context.EncounterTime.LocalDateTime.ToString("MMM d, yyyy")</MudTd>
                            <MudTd DataLabel="Log">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Size="Size.Small"
                                               Href="@($"/api/reports/{context.EncounterId}/view")"
                                               Target="_blank"
                                               Title="View Report" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>

        @* Recent Activity *@
        <MudItem xs="12">
            <MudPaper Class="pa-4" Elevation="2">
                <MudText Typo="Typo.h6" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" />
                    Recent Activity
                </MudText>
                @if (_profile.RecentActivity.Count == 0)
                {
                    <MudAlert Severity="Severity.Info">No recent activity.</MudAlert>
                }
                else
                {
                    <MudTable Items="@_profile.RecentActivity"
                              Dense="true"
                              Hover="true"
                              Striped="true">
                        <HeaderContent>
                            <MudTh>Boss</MudTh>
                            <MudTh>Mode</MudTh>
                            <MudTh>Result</MudTh>
                            <MudTh>DPS</MudTh>
                            <MudTh>Class</MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Date</MudTh>
                            <MudTh>Log</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Boss">@context.BossName</MudTd>
                            <MudTd DataLabel="Mode">
                                <MudChip T="string" Size="Size.Small" Color="@(context.IsCM ? Color.Warning : Color.Default)">
                                    @(context.IsCM ? "CM" : "NM")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Result">
                                @if (context.Success)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Kill</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Wipe</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="DPS">@context.Dps.ToString("N0")</MudTd>
                            <MudTd DataLabel="Class">@context.Profession</MudTd>
                            <MudTd DataLabel="Role">
                                <MudChip T="string" Size="Size.Small" Color="@GetRoleColor(context.Role)">@context.Role</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Date">@context.EncounterTime.LocalDateTime.ToString("MMM d, yyyy HH:mm")</MudTd>
                            <MudTd DataLabel="Log">
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Size="Size.Small"
                                               Href="@($"/api/reports/{context.EncounterId}/view")"
                                               Target="_blank"
                                               Title="View Report" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter]
    public string AccountName { get; set; } = "";

    private bool _loading = true;
    private bool _loadingAchievements = true;
    private PlayerProfileDto? _profile;
    private PlayerAchievementsResponse? _achievements;
    private PlayerBoonCoverage? _boonCoverage;
    private string _personalBestSort = "wing";

    private IEnumerable<PersonalBest> SortedPersonalBests => _personalBestSort == "dps"
        ? _profile?.PersonalBests.OrderByDescending(pb => pb.Dps) ?? Enumerable.Empty<PersonalBest>()
        : _profile?.PersonalBests.OrderBy(pb => pb.Wing ?? 99).ThenBy(pb => pb.EncounterOrder).ThenBy(pb => pb.IsCM) ?? Enumerable.Empty<PersonalBest>();

    protected override async Task OnParametersSetAsync()
    {
        await Task.WhenAll(
            LoadProfileAsync(),
            LoadAchievementsAsync()
        );
    }

    private async Task LoadProfileAsync()
    {
        _loading = true;
        try
        {
            _profile = await Http.GetFromJsonAsync<PlayerProfileDto>(
                $"api/players/{Uri.EscapeDataString(AccountName)}");
        }
        catch (Exception)
        {
            _profile = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }

        // Boon coverage needs the player Id from the profile, so it has to run after.
        // Fire-and-forget — the card renders a spinner until it lands.
        if (_profile != null)
        {
            _ = LoadBoonCoverageAsync();
        }
    }

    private async Task LoadBoonCoverageAsync()
    {
        try
        {
            _boonCoverage = await Http.GetFromJsonAsync<PlayerBoonCoverage>(
                $"api/boon-coverage/player/{_profile!.Id}");
        }
        catch (Exception)
        {
            _boonCoverage = null;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task LoadAchievementsAsync()
    {
        _loadingAchievements = true;
        try
        {
            _achievements = await Http.GetFromJsonAsync<PlayerAchievementsResponse>(
                $"api/achievements/player/{Uri.EscapeDataString(AccountName)}");
        }
        catch (Exception)
        {
            _achievements = null;
        }
        finally
        {
            _loadingAchievements = false;
            StateHasChanged();
        }
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/players");
    }

    private Color GetSuccessRateColor(decimal rate)
    {
        return rate switch
        {
            >= 80 => Color.Success,
            >= 50 => Color.Warning,
            _ => Color.Error
        };
    }

    private Color GetRoleColor(string role)
    {
        return role switch
        {
            "DPS" => Color.Error,
            "Boon DPS" => Color.Info,
            "Heal Boon" => Color.Success,
            _ => Color.Default
        };
    }

    // --- Boon coverage rendering helpers ---

    private enum BoonSlice { Generation, Self }

    private static Color UptimeColor(decimal? pct) => pct switch
    {
        null => Color.Default,
        >= 95 => Color.Success,
        >= 80 => Color.Warning,
        _ => Color.Error
    };

    private static (decimal? avg, int encounters) Pick(BoonSummary s, BoonSlice slice)
        => slice == BoonSlice.Generation
            ? (s.GenerationAvg, s.GenerationEncounters)
            : (s.SelfAvg, s.SelfEncounters);

    private RenderFragment RenderBoonHeadline(string boonName, BoonSummary summary) => __builder =>
    {
        <MudPaper Class="pa-3" Elevation="0" Style="background-color: var(--mud-palette-background-gray);">
            <MudText Typo="Typo.subtitle1" Class="mb-2"><strong>@boonName</strong></MudText>
            <MudStack Spacing="1">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">As generator (party uptime)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@summary.GenerationEncounters encounters</MudText>
                    </MudStack>
                    @if (summary.GenerationAvg.HasValue)
                    {
                        <MudChip T="string" Color="@UptimeColor(summary.GenerationAvg)" Size="Size.Large" Variant="Variant.Filled">
                            @($"{summary.GenerationAvg.Value:0.0}%")
                        </MudChip>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">—</MudText>
                    }
                </MudStack>
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">On myself (receiver)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Tertiary">@summary.SelfEncounters encounters</MudText>
                    </MudStack>
                    @if (summary.SelfAvg.HasValue)
                    {
                        <MudChip T="string" Color="@UptimeColor(summary.SelfAvg)" Size="Size.Large" Variant="Variant.Filled">
                            @($"{summary.SelfAvg.Value:0.0}%")
                        </MudChip>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">—</MudText>
                    }
                </MudStack>
            </MudStack>
        </MudPaper>
    };

    private RenderFragment RenderBoonBreakdown(PlayerBoonCoverage cov, BoonSlice slice) => __builder =>
    {
        // Filter to rows that have at least one encounter for this slice — otherwise the table
        // is mostly em-dashes for bosses/professions you never played in that role.
        var bosses = cov.PerBoss
            .Where(b => Pick(b.Quickness, slice).encounters > 0 || Pick(b.Alacrity, slice).encounters > 0)
            .ToList();
        var profs = cov.PerProfession
            .Where(p => Pick(p.Quickness, slice).encounters > 0 || Pick(p.Alacrity, slice).encounters > 0)
            .ToList();

        var label = slice == BoonSlice.Generation ? "as generator" : "on myself";
        if (bosses.Count == 0 && profs.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No encounters @label in the active range.</MudAlert>
            return;
        }

        if (bosses.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">Per Boss</MudText>
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Boss</th>
                        <th style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Quickness</th>
                        <th style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Alacrity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var boss in bosses)
                    {
                        var q = Pick(boss.Quickness, slice);
                        var a = Pick(boss.Alacrity, slice);
                        <tr>
                            <td>
                                @boss.BossName
                                @if (boss.IsCM)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">CM</MudChip>
                                }
                            </td>
                            <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptimeWithCount(q.avg, q.encounters)</td>
                            <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptimeWithCount(a.avg, a.encounters)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        if (profs.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Per Profession × Role</MudText>
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>Profession</th>
                        <th>Role</th>
                        <th style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Quickness</th>
                        <th style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Alacrity</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prof in profs)
                    {
                        var q = Pick(prof.Quickness, slice);
                        var a = Pick(prof.Alacrity, slice);
                        <tr>
                            <td>@prof.Profession</td>
                            <td><MudText Typo="Typo.caption" Color="Color.Secondary">@prof.Role</MudText></td>
                            <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptimeWithCount(q.avg, q.encounters)</td>
                            <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptimeWithCount(a.avg, a.encounters)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    };

    private RenderFragment RenderUptimeWithCount(decimal? pct, int encounters) => __builder =>
    {
        if (pct == null || encounters == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
        }
        else
        {
            <MudStack Row="true" Spacing="1" Justify="Justify.Center" AlignItems="AlignItems.Center">
                <MudChip T="string" Size="Size.Small" Color="@UptimeColor(pct)" Variant="Variant.Filled">
                    @($"{pct:0}%")
                </MudChip>
                <MudText Typo="Typo.caption" Color="Color.Secondary">@encounters encs</MudText>
            </MudStack>
        }
    };

