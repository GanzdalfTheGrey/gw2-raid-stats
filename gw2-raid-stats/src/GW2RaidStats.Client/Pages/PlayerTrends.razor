@page "/players/{AccountName}/trends"
@using GW2RaidStats.Core
@inject HttpClient Http
@inject NavigationManager Navigation

<PageTitle>GW2 Raid Stats - @AccountName Trends</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">@AccountName — Trends</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            DPS, Boon DPS, and Heals progression over time per boss.
        </MudText>
    </MudStack>
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="@($"/players/{Uri.EscapeDataString(AccountName)}")">
        Back to Profile
    </MudButton>
</MudStack>

@if (_loadingBosses)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_bossOptions.Count == 0)
{
    <MudAlert Severity="Severity.Info">No kills recorded for this player yet.</MudAlert>
}
else
{
    <MudPaper Class="pa-3 mb-4" Elevation="1">
        <MudGrid AlignItems="AlignItems.Center">
            <MudItem xs="12" md="5">
                <MudAutocomplete T="BossEncounterCountDto"
                                 Value="_selectedBoss"
                                 ValueChanged="OnBossChanged"
                                 SearchFunc="@SearchBosses"
                                 ToStringFunc="@(b => b == null ? "" : FormatBossOption(b))"
                                 Label="Boss"
                                 Placeholder="Type to filter..."
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 ResetValueOnEmptyText="false"
                                 SelectValueOnTab="true"
                                 OpenOnFocus="true"
                                 CoerceText="true" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-2">Role:</MudText>
                <MudToggleGroup T="string" Value="_role" ValueChanged="OnRoleChanged"
                                Color="Color.Primary" Size="Size.Small" CheckMark="false">
                    <MudToggleItem Value="@("DPS")" Text="DPS" />
                    <MudToggleItem Value="@("Boon DPS")" Text="Boon DPS" />
                </MudToggleGroup>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-2">Range:</MudText>
                <MudToggleGroup T="string" Value="_range" ValueChanged="OnRangeChanged"
                                Color="Color.Primary" Size="Size.Small" CheckMark="false">
                    <MudToggleItem Value="@("patch")" Text="This Patch" />
                    <MudToggleItem Value="@("90d")" Text="Last 90d" />
                    <MudToggleItem Value="@("all")" Text="All Time" />
                </MudToggleGroup>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_loadingTrends)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else if (_trends == null || _trends.Points.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No @RoleLabel data for this boss in the selected range. Try a different role or wider range.
        </MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="9">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        <strong>@RoleLabel over time</strong> — @_trends.TotalKills kill(s)
                    </MudText>
                    <MudChart ChartType="ChartType.Line"
                              ChartSeries="@_series"
                              XAxisLabels="@_xLabels"
                              Width="100%" Height="350px"
                              ChartOptions="@_chartOptions" />
                </MudPaper>
            </MudItem>
            <MudItem xs="12" md="3">
                <MudPaper Class="pa-4" Elevation="1">
                    <MudText Typo="Typo.subtitle1" Class="mb-3"><strong>Stats</strong></MudText>
                    <MudStack Spacing="3">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Personal Best</MudText>
                            @if (_trends.PersonalBest != null)
                            {
                                <MudText Typo="Typo.h6" Color="Color.Success">@_trends.PersonalBest.Value.ToString("N0")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @_trends.PersonalBest.EncounterTime.LocalDateTime.ToString("MMM d, yyyy")
                                </MudText>
                            }
                            else
                            {
                                <MudText>—</MudText>
                            }
                        </MudStack>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Last 5 vs Prev 5</MudText>
                            @if (_trends.Points.Count >= 6)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@TrendIcon(_trends.TrendPct)"
                                             Color="@TrendColor(_trends.TrendPct)" />
                                    <MudText Typo="Typo.h6" Color="@TrendColor(_trends.TrendPct)">
                                        @TrendPctString(_trends.TrendPct)
                                    </MudText>
                                </MudStack>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">need 6+ kills</MudText>
                            }
                        </MudStack>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Guild Median</MudText>
                            @if (_trends.GuildMedian > 0)
                            {
                                <MudText Typo="Typo.h6">@_trends.GuildMedian.ToString("N0")</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    across all included members in this role
                                </MudText>
                            }
                            else
                            {
                                <MudText>—</MudText>
                            }
                        </MudStack>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Guild Record</MudText>
                            @if (_trends.GuildTop > 0)
                            {
                                <MudText Typo="Typo.h6" Color="Color.Warning">@_trends.GuildTop.ToString("N0")</MudText>
                                @if (_trends.PersonalBest != null && _trends.GuildTop > _trends.PersonalBest.Value)
                                {
                                    var gap = _trends.GuildTop - _trends.PersonalBest.Value;
                                    var pct = (decimal)gap / _trends.GuildTop * 100;
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @gap.ToString("N0") to beat (@pct.ToString("F1")%)
                                    </MudText>
                                }
                                else if (_trends.PersonalBest != null)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Success">you hold the record</MudText>
                                }
                            }
                            else
                            {
                                <MudText>—</MudText>
                            }
                        </MudStack>
                    </MudStack>
                </MudPaper>
            </MudItem>
        </MudGrid>
    }
}

@code {
    [Parameter] public string AccountName { get; set; } = "";

    private bool _loadingBosses = true;
    private bool _loadingTrends = false;
    private List<BossEncounterCountDto> _bossOptions = new();
    private BossEncounterCountDto? _selectedBoss;
    private string _role = "DPS";
    private string _range = "patch";
    private PlayerTrendsDto? _trends;

    private List<ChartSeries> _series = new();
    private string[] _xLabels = Array.Empty<string>();
    private ChartOptions _chartOptions = new() { LineStrokeWidth = 2, YAxisFormat = "n0" };

    private string RoleLabel => _role switch
    {
        "DPS" => "DPS",
        "Boon DPS" => "Boon DPS",
        _ => _role
    };

    protected override async Task OnParametersSetAsync()
    {
        await LoadBossesAsync(initial: true);
    }

    private async Task LoadBossesAsync(bool initial = false)
    {
        _loadingBosses = true;
        try
        {
            var list = await Http.GetFromJsonAsync<List<BossEncounterCountDto>>(
                $"api/players/{Uri.EscapeDataString(AccountName)}/trends/bosses?range={_range}");
            _bossOptions = list ?? new();

            if (_bossOptions.Count == 0)
            {
                _selectedBoss = null;
                _trends = null;
                return;
            }

            // Default selection on initial load: highest kill count (most familiar boss).
            // On subsequent loads (range change), keep the existing pick if still present;
            // otherwise fall back to the highest count in the new range.
            BossEncounterCountDto? newSelection = null;
            if (initial)
            {
                newSelection = _bossOptions.OrderByDescending(b => b.Count).First();
            }
            else if (_selectedBoss != null)
            {
                newSelection = _bossOptions.FirstOrDefault(b =>
                    b.TriggerId == _selectedBoss.TriggerId && b.IsCM == _selectedBoss.IsCM);
            }
            newSelection ??= _bossOptions.OrderByDescending(b => b.Count).First();

            _selectedBoss = newSelection;
            await LoadTrendsAsync();
        }
        catch
        {
            _bossOptions = new();
        }
        finally
        {
            _loadingBosses = false;
            StateHasChanged();
        }
    }

    private Task<IEnumerable<BossEncounterCountDto>> SearchBosses(string? value, CancellationToken ct)
    {
        // Empty input → show all bosses.
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<BossEncounterCountDto>>(_bossOptions);

        // When a boss is selected, the input displays the ToStringFunc output (e.g.
        // "Cairn · 5 kill(s)"). MudAutocomplete then re-runs SearchFunc with that string
        // as input on focus, which would normally yield zero matches and an empty list.
        // Treat the case where the input equals the selected boss's display string as
        // "show me all the options" so clicking back into the field reveals the list.
        if (_selectedBoss != null && value == FormatBossOption(_selectedBoss))
        {
            return Task.FromResult<IEnumerable<BossEncounterCountDto>>(_bossOptions);
        }

        return Task.FromResult<IEnumerable<BossEncounterCountDto>>(
            _bossOptions.Where(b => b.BossName.Contains(value, StringComparison.OrdinalIgnoreCase))
        );
    }

    private static string FormatBossOption(BossEncounterCountDto b)
        => $"{b.BossName}{(b.IsCM ? " (CM)" : "")} · {b.Count} kill(s)";

    private async Task OnBossChanged(BossEncounterCountDto value)
    {
        _selectedBoss = value;
        await LoadTrendsAsync();
    }

    private async Task OnRoleChanged(string value)
    {
        _role = value;
        await LoadTrendsAsync();
    }

    private async Task OnRangeChanged(string value)
    {
        _range = value;
        // Reload the boss list so kill counts reflect the new range.
        await LoadBossesAsync(initial: false);
    }

    private async Task LoadTrendsAsync()
    {
        if (_selectedBoss == null)
        {
            _trends = null;
            BuildChart();
            return;
        }
        _loadingTrends = true;
        try
        {
            var url = $"api/players/{Uri.EscapeDataString(AccountName)}/trends" +
                $"?triggerId={_selectedBoss.TriggerId}" +
                $"&isCm={_selectedBoss.IsCM.ToString().ToLowerInvariant()}" +
                $"&role={Uri.EscapeDataString(_role)}" +
                $"&range={_range}";
            _trends = await Http.GetFromJsonAsync<PlayerTrendsDto>(url);
            BuildChart();
        }
        catch
        {
            _trends = null;
        }
        finally
        {
            _loadingTrends = false;
            StateHasChanged();
        }
    }

    private void BuildChart()
    {
        if (_trends == null || _trends.Points.Count == 0)
        {
            _series = new();
            _xLabels = Array.Empty<string>();
            return;
        }

        // MudChart's Line type can't render a path of length 1, which means a single
        // kill produces an empty plot. Pad single-point data with a leading sentinel
        // entry that repeats the same value so the line has horizontal length and the
        // marker dot at the endpoint is visible. Median series is repeated to match.
        if (_trends.Points.Count == 1)
        {
            var only = _trends.Points[0];
            var label = only.EncounterTime.LocalDateTime.ToString("MMM d");
            _xLabels = new[] { "", label };

            var seriesList = new List<ChartSeries>
            {
                new ChartSeries
                {
                    Name = RoleLabel,
                    Data = new[] { (double)only.Value, (double)only.Value }
                }
            };
            if (_trends.GuildMedian > 0)
            {
                var med = (double)_trends.GuildMedian;
                seriesList.Add(new ChartSeries
                {
                    Name = "Guild Median",
                    Data = new[] { med, med }
                });
            }
            if (_trends.GuildTop > 0)
            {
                var top = (double)_trends.GuildTop;
                seriesList.Add(new ChartSeries
                {
                    Name = "Guild Record",
                    Data = new[] { top, top }
                });
            }
            _series = seriesList;
            return;
        }

        _xLabels = _trends.Points
            .Select(p => p.EncounterTime.LocalDateTime.ToString("MMM d"))
            .ToArray();

        var playerSeries = new ChartSeries
        {
            Name = RoleLabel,
            Data = _trends.Points.Select(p => (double)p.Value).ToArray()
        };

        var allSeries = new List<ChartSeries> { playerSeries };

        if (_trends.GuildMedian > 0)
        {
            // Constant line at guild median for easy visual comparison
            var medianValue = (double)_trends.GuildMedian;
            allSeries.Add(new ChartSeries
            {
                Name = "Guild Median",
                Data = Enumerable.Repeat(medianValue, _trends.Points.Count).ToArray()
            });
        }

        if (_trends.GuildTop > 0)
        {
            // Constant line at the guild record (top DPS in this role/range) so the
            // user can see how close they were to breaking it.
            var topValue = (double)_trends.GuildTop;
            allSeries.Add(new ChartSeries
            {
                Name = "Guild Record",
                Data = Enumerable.Repeat(topValue, _trends.Points.Count).ToArray()
            });
        }

        _series = allSeries;
    }

    private static string TrendIcon(decimal pct)
        => pct > 0.5m ? Icons.Material.Filled.TrendingUp
         : pct < -0.5m ? Icons.Material.Filled.TrendingDown
         : Icons.Material.Filled.TrendingFlat;

    private static Color TrendColor(decimal pct)
        => pct > 0.5m ? Color.Success
         : pct < -0.5m ? Color.Error
         : Color.Default;

    private static string TrendPctString(decimal pct)
        => (pct >= 0 ? "+" : "") + pct.ToString("F1") + "%";

    public record PlayerTrendsDto(
        List<TrendPoint> Points,
        TrendPoint? PersonalBest,
        int GuildMedian,
        int GuildTop,
        decimal TrendPct,
        int TotalKills);

    public record TrendPoint(DateTimeOffset EncounterTime, int Value);

    public record BossEncounterCountDto(
        int TriggerId,
        string BossName,
        bool IsCM,
        int Count);
}
