@page "/roles/matrix"
@using GW2RaidStats.Core
@using GW2RaidStats.Core.Roles
@inject HttpClient Http
@inject ISnackbar Snackbar

<PageTitle>GW2 Raid Stats - Roles Matrix</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">Roles Matrix</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Click any cell to set a player's status. Click an account name to open the full editor.
        </MudText>
    </MudStack>
    <MudButton Variant="Variant.Outlined"
               StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/players">
        Players
    </MudButton>
</MudStack>

@* Filter bar — wraps gracefully on narrow screens *@
<MudPaper Class="pa-3 mb-3" Elevation="1">
    <div class="filter-bar">
        <div class="filter-search">
            <MudTextField @bind-Value="_search"
                          Placeholder="Search players..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          DebounceInterval="200" />
        </div>
        <div class="filter-toggle">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="filter-label">Show:</MudText>
            <MudToggleGroup T="string" @bind-Value="_showMode" Color="Color.Primary" Size="Size.Small" CheckMark="false">
                <MudToggleItem Value="@("both")" Text="Both" />
                <MudToggleItem Value="@("generic")" Text="Generic" />
                <MudToggleItem Value="@("mechanics")" Text="Mechanics" />
            </MudToggleGroup>
        </div>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_matrix == null || _matrix.Rows.Count == 0)
{
    <MudAlert Severity="Severity.Info">No included guild members yet. Mark players as included on the Manage Data page first.</MudAlert>
}
else
{
    <MudPaper Class="pa-2" Elevation="1">
        <div class="matrix-scroll">
            <table class="role-matrix">
                <thead>
                    <tr>
                        <th class="player-col" rowspan="2">Player</th>
                        @if (ShowGeneric)
                        {
                            <th class="group-header heal-tint" colspan="2">Heal</th>
                            <th class="group-header boondps-tint" colspan="4">Boon DPS</th>
                            <th class="group-header dps-tint" colspan="2">DPS</th>
                        }
                        @if (ShowMechanics)
                        {
                            @foreach (var grp in _bossGroups)
                            {
                                <th class="group-header boss-divider" colspan="@grp.Columns.Count">
                                    W@(grp.Wing) — @grp.BossName
                                </th>
                            }
                        }
                        <th class="stats-col" rowspan="2">Stats</th>
                    </tr>
                    <tr>
                        @if (ShowGeneric)
                        {
                            @foreach (var role in _genericRoles)
                            {
                                <th class="@GenericTintClass(role)" title="@role.DisplayName()">@RoleShortLabel(role)</th>
                            }
                        }
                        @if (ShowMechanics)
                        {
                            @foreach (var grp in _bossGroups)
                            {
                                @for (int i = 0; i < grp.Columns.Count; i++)
                                {
                                    var col = grp.Columns[i];
                                    var first = i == 0;
                                    <th class="@(first ? "boss-divider" : "")" title="@($"{col.BossName} — {col.Name} ({col.Constraint.DisplayName()})")">@col.Name</th>
                                }
                            }
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in FilteredRows)
                    {
                        <tr class="player-row">
                            <td class="player-col">
                                <MudLink Href="@($"/players/{Uri.EscapeDataString(row.AccountName)}/roles")" Underline="Underline.Hover">
                                    @row.AccountName
                                </MudLink>
                            </td>
                            @if (ShowGeneric)
                            {
                                @foreach (var role in _genericRoles)
                                {
                                    var status = row.GenericByRole.ContainsKey((int)role) ? (RoleCapabilityStatus?)row.GenericByRole[(int)role] : null;
                                    var captureRow = row;
                                    var captureRole = role;
                                    <td class="@GenericTintClass(role)">
                                        <MudMenu ActivationEvent="@MouseEvent.LeftClick" Dense="true" AnchorOrigin="Origin.BottomCenter">
                                            <ActivatorContent>
                                                <MudTooltip Text="@($"{role.DisplayName()}: {StatusLabel(status)}")" Arrow="true">
                                                    <div class="@DotClass(status)"></div>
                                                </MudTooltip>
                                            </ActivatorContent>
                                            <ChildContent>
                                                @foreach (var s in _editStatuses)
                                                {
                                                    var captureStatus = s;
                                                    <MudMenuItem OnClick="@(() => SetGenericAsync(captureRow, captureRole, captureStatus))">
                                                        <div class="menu-row">
                                                            <div class="@DotClass(captureStatus)"></div>
                                                            <span>@StatusLabel(captureStatus)</span>
                                                        </div>
                                                    </MudMenuItem>
                                                }
                                                <MudDivider />
                                                <MudMenuItem OnClick="@(() => SetGenericAsync(captureRow, captureRole, null))">
                                                    <div class="menu-row">
                                                        <div class="role-dot role-dot-empty"></div>
                                                        <span class="text-muted">Clear</span>
                                                    </div>
                                                </MudMenuItem>
                                            </ChildContent>
                                        </MudMenu>
                                    </td>
                                }
                            }
                            @if (ShowMechanics)
                            {
                                @foreach (var grp in _bossGroups)
                                {
                                    @for (int i = 0; i < grp.Columns.Count; i++)
                                    {
                                        var col = grp.Columns[i];
                                        var first = i == 0;
                                        var status = row.MechanicById.ContainsKey(col.Id) ? (RoleCapabilityStatus?)row.MechanicById[col.Id] : null;
                                        var captureRow = row;
                                        var captureCol = col;
                                        <td class="@(first ? "boss-divider" : "")">
                                            <MudMenu ActivationEvent="@MouseEvent.LeftClick" Dense="true" AnchorOrigin="Origin.BottomCenter">
                                                <ActivatorContent>
                                                    <MudTooltip Text="@($"{col.BossName} — {col.Name}: {StatusLabel(status)}")" Arrow="true">
                                                        <div class="@DotClass(status)"></div>
                                                    </MudTooltip>
                                                </ActivatorContent>
                                                <ChildContent>
                                                    @foreach (var s in _editStatuses)
                                                    {
                                                        var captureStatus = s;
                                                        <MudMenuItem OnClick="@(() => SetMechanicAsync(captureRow, captureCol, captureStatus))">
                                                            <div class="menu-row">
                                                                <div class="@DotClass(captureStatus)"></div>
                                                                <span>@StatusLabel(captureStatus)</span>
                                                            </div>
                                                        </MudMenuItem>
                                                    }
                                                    <MudDivider />
                                                    <MudMenuItem OnClick="@(() => SetMechanicAsync(captureRow, captureCol, null))">
                                                        <div class="menu-row">
                                                            <div class="role-dot role-dot-empty"></div>
                                                            <span class="text-muted">Clear</span>
                                                        </div>
                                                    </MudMenuItem>
                                                </ChildContent>
                                            </MudMenu>
                                        </td>
                                    }
                                }
                            }
                            <td class="stats-col">
                                @{ var stats = ComputeStats(row); }
                                <div class="stats-pills">
                                    <MudTooltip Text="Can" Arrow="true"><span class="stat-pill stat-can">@stats.Can</span></MudTooltip>
                                    <MudTooltip Text="Maybe" Arrow="true"><span class="stat-pill stat-maybe">@stats.Maybe</span></MudTooltip>
                                    <MudTooltip Text="Want to learn" Arrow="true"><span class="stat-pill stat-learn">@stats.Learn</span></MudTooltip>
                                    <MudTooltip Text="Can't" Arrow="true"><span class="stat-pill stat-cant">@stats.Cant</span></MudTooltip>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!FilteredRows.Any())
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">No players match the current filters.</MudAlert>
        }
    </MudPaper>
}

<style>
    /* Filter bar: flex with wrap so it adapts to any width */
    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 16px;
    }
    .filter-search {
        flex: 1 1 260px;
        min-width: 240px;
    }
    .filter-toggle {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .filter-label {
        white-space: nowrap;
    }

    .matrix-scroll {
        overflow-x: auto;
        max-width: 100%;
    }
    .role-matrix {
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
        font-size: 0.85rem;
    }
    .role-matrix thead th {
        position: sticky;
        top: 0;
        background: var(--mud-palette-surface);
        z-index: 2;
        padding: 6px 8px;
        border-bottom: 1px solid var(--mud-palette-divider);
        text-align: center;
        white-space: nowrap;
        font-weight: 600;
    }
    .role-matrix thead th.group-header {
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--mud-palette-text-secondary);
    }
    .role-matrix th.player-col,
    .role-matrix td.player-col {
        position: sticky;
        left: 0;
        background: var(--mud-palette-surface);
        z-index: 3;
        text-align: left;
        padding: 6px 12px;
        border-right: 1px solid var(--mud-palette-divider);
        min-width: 180px;
        max-width: 220px;
    }
    .role-matrix thead th.player-col {
        z-index: 4;
    }
    .role-matrix tbody td {
        padding: 4px 6px;
        text-align: center;
        border-bottom: 1px solid var(--mud-palette-divider-light);
    }
    .role-matrix tbody tr.player-row:nth-child(even) td {
        background: var(--mud-palette-background-gray);
    }
    /* Hover tint via inset box-shadow so sticky cells keep their opaque background
       and don't reveal the dots scrolling behind them. */
    .role-matrix tbody tr.player-row:hover td {
        box-shadow: inset 0 0 0 9999px rgba(33, 150, 243, 0.06);
    }
    .heal-tint, td.heal-tint { background: rgba(76, 175, 80, 0.08); }
    .boondps-tint, td.boondps-tint { background: rgba(33, 150, 243, 0.08); }
    .dps-tint, td.dps-tint { background: rgba(244, 67, 54, 0.08); }
    .role-matrix .boss-divider {
        border-left: 2px solid var(--mud-palette-divider);
    }
    .stats-col {
        padding: 4px 12px !important;
        min-width: 140px;
        text-align: right !important;
    }
    .stats-pills {
        display: flex;
        gap: 4px;
        justify-content: flex-end;
    }
    .stat-pill {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 11px;
        font-size: 0.72rem;
        font-weight: 600;
        color: white;
    }
    .stat-can { background: #4caf50; }
    .stat-maybe { background: #ff9800; }
    .stat-cant { background: #f44336; }
    .stat-learn { background: #2196f3; }
    .stat-pill:empty::before { content: "0"; }

    .role-dot {
        display: inline-block;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        cursor: pointer;
        margin: 0 auto;
        transition: transform 0.1s ease;
        vertical-align: middle;
        border: 2px solid transparent;
    }
    .role-dot:hover { transform: scale(1.18); }
    .role-dot-empty { border-color: var(--mud-palette-divider); background: transparent; }
    .role-dot-empty:hover { border-color: var(--mud-palette-text-secondary); }
    .role-dot-can { background: #4caf50; }
    .role-dot-maybe { background: #ff9800; }
    .role-dot-cant { background: #f44336; }
    .role-dot-learn { background: #2196f3; }

    .menu-row {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .text-muted { color: var(--mud-palette-text-secondary); }
</style>

@code {
    private bool _loading = true;
    private RolesMatrixDto? _matrix;
    private string _search = "";
    private string _showMode = "both";

    private static readonly GenericRole[] _genericRoles = Enum.GetValues<GenericRole>().OrderBy(r => (int)r).ToArray();
    private static readonly RoleCapabilityStatus[] _editStatuses = new[]
    {
        RoleCapabilityStatus.Can,
        RoleCapabilityStatus.Maybe,
        RoleCapabilityStatus.WantToLearn,
        RoleCapabilityStatus.Cant,
    };

    private List<BossColumnGroup> _bossGroups = new();

    private bool ShowGeneric => _showMode == "both" || _showMode == "generic";
    private bool ShowMechanics => _showMode == "both" || _showMode == "mechanics";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _matrix = await Http.GetFromJsonAsync<RolesMatrixDto>("api/roles/matrix");
            BuildBossGroups();
        }
        catch
        {
            _matrix = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void BuildBossGroups()
    {
        if (_matrix == null) { _bossGroups = new(); return; }

        _bossGroups = _matrix.Mechanics
            .GroupBy(m => new { m.TriggerId, m.BossName })
            .Select(g => new BossColumnGroup
            {
                TriggerId = g.Key.TriggerId,
                BossName = g.Key.BossName,
                Wing = WingMapping.GetWing(g.Key.TriggerId) ?? 99,
                EncounterOrder = WingMapping.GetEncounterOrder(g.Key.TriggerId),
                Columns = g.OrderBy(c => c.SortOrder).ThenBy(c => c.Name).ToList()
            })
            .OrderBy(g => g.Wing).ThenBy(g => g.EncounterOrder).ThenBy(g => g.BossName)
            .ToList();
    }

    private IEnumerable<RolesMatrixRowDto> FilteredRows
    {
        get
        {
            if (_matrix == null) return Enumerable.Empty<RolesMatrixRowDto>();
            IEnumerable<RolesMatrixRowDto> q = _matrix.Rows;
            if (!string.IsNullOrWhiteSpace(_search))
            {
                q = q.Where(r => r.AccountName.Contains(_search, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    private async Task SetGenericAsync(RolesMatrixRowDto row, GenericRole role, RoleCapabilityStatus? status)
    {
        var resp = await Http.PutAsJsonAsync(
            $"api/admin/players/{Uri.EscapeDataString(row.AccountName)}/roles/generic/{role}",
            new SetRoleStatusRequest(status, null));
        if (!resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Failed to save", Severity.Error);
            return;
        }

        if (status == null) row.GenericByRole.Remove((int)role);
        else row.GenericByRole[(int)role] = status.Value;
        StateHasChanged();
    }

    private async Task SetMechanicAsync(RolesMatrixRowDto row, MechanicRoleDto col, RoleCapabilityStatus? status)
    {
        var resp = await Http.PutAsJsonAsync(
            $"api/admin/players/{Uri.EscapeDataString(row.AccountName)}/roles/mechanic/{col.Id}",
            new SetRoleStatusRequest(status, null));
        if (!resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Failed to save", Severity.Error);
            return;
        }

        if (status == null) row.MechanicById.Remove(col.Id);
        else row.MechanicById[col.Id] = status.Value;
        StateHasChanged();
    }

    private record RowStats(int Can, int Maybe, int Cant, int Learn);

    private RowStats ComputeStats(RolesMatrixRowDto row)
    {
        int can = 0, maybe = 0, cant = 0, learn = 0;
        void tally(RoleCapabilityStatus s)
        {
            switch (s)
            {
                case RoleCapabilityStatus.Can: can++; break;
                case RoleCapabilityStatus.Maybe: maybe++; break;
                case RoleCapabilityStatus.Cant: cant++; break;
                case RoleCapabilityStatus.WantToLearn: learn++; break;
            }
        }
        foreach (var v in row.GenericByRole.Values) tally(v);
        foreach (var v in row.MechanicById.Values) tally(v);
        return new RowStats(can, maybe, cant, learn);
    }

    private static string GenericTintClass(GenericRole role) => role.GetSlot() switch
    {
        RoleSlot.Heal => "heal-tint",
        RoleSlot.BoonDps => "boondps-tint",
        RoleSlot.Dps => "dps-tint",
        _ => ""
    };

    private static string RoleShortLabel(GenericRole role) => role switch
    {
        GenericRole.AlacHeal => "Alac",
        GenericRole.QuickHeal => "Quick",
        GenericRole.AlacDpsPower => "Alac Pwr",
        GenericRole.AlacDpsCondi => "Alac Con",
        GenericRole.QuickDpsPower => "Quick Pwr",
        GenericRole.QuickDpsCondi => "Quick Con",
        GenericRole.DpsPower => "Power",
        GenericRole.DpsCondi => "Condi",
        _ => role.ToString()
    };

    private static string DotClass(RoleCapabilityStatus? s) => s switch
    {
        null => "role-dot role-dot-empty",
        RoleCapabilityStatus.Can => "role-dot role-dot-can",
        RoleCapabilityStatus.Maybe => "role-dot role-dot-maybe",
        RoleCapabilityStatus.Cant => "role-dot role-dot-cant",
        RoleCapabilityStatus.WantToLearn => "role-dot role-dot-learn",
        _ => "role-dot role-dot-empty"
    };

    private static string StatusLabel(RoleCapabilityStatus? s) => s switch
    {
        null => "Unset",
        RoleCapabilityStatus.Can => "Can",
        RoleCapabilityStatus.Maybe => "Maybe",
        RoleCapabilityStatus.Cant => "Can't",
        RoleCapabilityStatus.WantToLearn => "Want to learn",
        _ => "?"
    };

    private class BossColumnGroup
    {
        public int TriggerId { get; set; }
        public string BossName { get; set; } = "";
        public int Wing { get; set; }
        public int EncounterOrder { get; set; }
        public List<MechanicRoleDto> Columns { get; set; } = new();
    }

    public record RolesMatrixDto(
        List<MechanicRoleDto> Mechanics,
        List<RolesMatrixRowDto> Rows);

    public class RolesMatrixRowDto
    {
        public Guid PlayerId { get; set; }
        public string AccountName { get; set; } = "";
        public Dictionary<int, RoleCapabilityStatus> GenericByRole { get; set; } = new();
        public Dictionary<Guid, RoleCapabilityStatus> MechanicById { get; set; } = new();
    }

    public record MechanicRoleDto(
        Guid Id,
        int TriggerId,
        string BossName,
        string Name,
        MechanicConstraint Constraint,
        int MinCount,
        int MaxCount,
        int SortOrder);

    public record SetRoleStatusRequest(RoleCapabilityStatus? Status, string? Notes);
}
