@page "/sessions"
@inject HttpClient Http

<PageTitle>GW2 Raid Stats - Past Sessions</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3" Wrap="Wrap.Wrap">
    <MudStack Spacing="0">
        <MudText Typo="Typo.h4">Past Sessions</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Browse any prior raid night. Pick a session below to see its logs and boon coverage.
        </MudText>
    </MudStack>
</MudStack>

@if (_loadingSessions)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (_sessions is null || _sessions.Count == 0)
{
    <MudAlert Severity="Severity.Info">No sessions yet.</MudAlert>
}
else
{
    <MudGrid>
        <MudItem xs="12" md="4" lg="3">
            <MudPaper Class="pa-2" Elevation="2" Style="max-height: 78vh; overflow-y: auto;">
                <MudList T="SessionSummary"
                         SelectedValue="_selected"
                         SelectedValueChanged="@OnSessionSelected"
                         Dense="true"
                         Color="Color.Primary">
                    @foreach (var s in _sessions)
                    {
                        <MudListItem T="SessionSummary" Value="@s">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.body1">
                                    <strong>@s.SessionDate.LocalDateTime.ToString("dddd, MMM d")</strong>
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @s.SessionDate.LocalDateTime.ToString("yyyy")
                                    · @s.TotalKills/@s.TotalAttempts kills
                                    · @FormatSessionTime(s.TotalTimeSeconds)
                                </MudText>
                            </MudStack>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="8" lg="9">
            @if (_loadingSelected)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (_selectedSession == null)
            {
                <MudAlert Severity="Severity.Info">Pick a session from the list.</MudAlert>
            }
            else
            {
                <MudPaper Class="pa-4" Elevation="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-3" Wrap="Wrap.Wrap" Spacing="2">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">
                                @_selectedSession.SessionTime.LocalDateTime.ToString("dddd, MMMM d, yyyy")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Session
                            </MudText>
                        </MudStack>
                        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @_selectedSession.TotalAttempts attempts
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                @_selectedSession.TotalKills kills
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Title="Boss Time">
                                @FormatSessionTime(_selectedSession.TotalTimeSeconds)
                            </MudChip>
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Title="Downtime">
                                @FormatSessionTime(_selectedSession.DowntimeSeconds) down
                            </MudChip>
                        </MudStack>
                    </MudStack>

                    <MudTabs Outlined="false" Rounded="true" Border="false" Position="Position.Top" PanelClass="mt-3">
                        <MudTabPanel Text="Logs" Icon="@Icons.Material.Filled.List">
                            <MudSimpleTable Dense="true" Striped="true" Hover="true">
                                <thead>
                                    <tr>
                                        <th>Boss</th>
                                        <th>Result</th>
                                        <th>Duration</th>
                                        <th>Time</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var encounter in _selectedSession.Encounters)
                                    {
                                        <tr>
                                            <td>
                                                @encounter.BossName
                                                @if (encounter.IsCM)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">CM</MudChip>
                                                }
                                            </td>
                                            <td>
                                                @if (encounter.Success)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Success">Kill</MudChip>
                                                }
                                                else
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Wipe</MudChip>
                                                }
                                            </td>
                                            <td>@FormatDuration(encounter.DurationMs)</td>
                                            <td>@encounter.EncounterTime.LocalDateTime.ToString("h:mm tt")</td>
                                            <td>
                                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                                               Size="Size.Small"
                                                               Href="@($"/api/reports/{encounter.Id}/view")"
                                                               Target="_blank"
                                                               Title="View Report" />
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudTabPanel>
                        <MudTabPanel Text="Session Stats" Icon="@Icons.Material.Filled.BarChart">
                            @if (_boonCoverage == null)
                            {
                                <MudStack AlignItems="AlignItems.Center" Class="pa-4">
                                    <MudProgressCircular Indeterminate="true" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Computing boon coverage...</MudText>
                                </MudStack>
                            }
                            else if (_boonCoverage.Count == 0)
                            {
                                <MudAlert Severity="Severity.Info">No coverage data for this session.</MudAlert>
                            }
                            else
                            {
                                var mainSubs = MainSubs(_boonCoverage);
                                int? subA = mainSubs.Count > 0 ? mainSubs[0] : null;
                                int? subB = mainSubs.Count > 1 ? mainSubs[1] : null;
                                var visibleSubs = mainSubs.ToHashSet();
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                    Per-sub average Quickness / Alacrity self-uptime (excludes dead/down time).
                                    Green &gt; 90%, yellow &gt; 80%, red ≤ 80%. Shows the two largest subs by player count — a small kite/utility sub is omitted.
                                </MudText>
                                <MudSimpleTable Dense="true" Striped="true" Hover="true">
                                    <thead>
                                        <tr>
                                            <th rowspan="2">Boss</th>
                                            @if (subA.HasValue)
                                            {
                                                <th colspan="2" style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Sub @subA</th>
                                            }
                                            @if (subB.HasValue)
                                            {
                                                <th colspan="2" style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Sub @subB</th>
                                            }
                                            <th rowspan="2" style="border-left: 1px solid var(--mud-palette-divider);">Booners</th>
                                        </tr>
                                        <tr>
                                            @if (subA.HasValue)
                                            {
                                                <th style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Q</th>
                                                <th style="text-align: center;">A</th>
                                            }
                                            @if (subB.HasValue)
                                            {
                                                <th style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">Q</th>
                                                <th style="text-align: center;">A</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var enc in _boonCoverage)
                                        {
                                            var encSubA = subA.HasValue ? enc.Subs.FirstOrDefault(s => s.SubGroup == subA.Value) : null;
                                            var encSubB = subB.HasValue ? enc.Subs.FirstOrDefault(s => s.SubGroup == subB.Value) : null;
                                            var visibleGenerators = enc.Generators.Where(g => visibleSubs.Contains(g.SubGroup)).ToList();
                                            <tr>
                                                <td>
                                                    @enc.BossName
                                                    @if (enc.IsCM)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Class="ml-1">CM</MudChip>
                                                    }
                                                    @if (!enc.Success)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Error" Class="ml-1">wipe</MudText>
                                                    }
                                                </td>
                                                @if (subA.HasValue)
                                                {
                                                    <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptime(encSubA?.AvgQuicknessUptime)</td>
                                                    <td style="text-align: center;">@RenderUptime(encSubA?.AvgAlacrityUptime)</td>
                                                }
                                                @if (subB.HasValue)
                                                {
                                                    <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptime(encSubB?.AvgQuicknessUptime)</td>
                                                    <td style="text-align: center;">@RenderUptime(encSubB?.AvgAlacrityUptime)</td>
                                                }
                                                <td style="border-left: 1px solid var(--mud-palette-divider);">@RenderGenerators(visibleGenerators)</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        <tr style="font-weight: bold; border-top: 2px solid var(--mud-palette-divider);">
                                            <td>Session avg</td>
                                            @if (subA.HasValue)
                                            {
                                                <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptime(SessionAvg(_boonCoverage, subA.Value, true))</td>
                                                <td style="text-align: center;">@RenderUptime(SessionAvg(_boonCoverage, subA.Value, false))</td>
                                            }
                                            @if (subB.HasValue)
                                            {
                                                <td style="text-align: center; border-left: 1px solid var(--mud-palette-divider);">@RenderUptime(SessionAvg(_boonCoverage, subB.Value, true))</td>
                                                <td style="text-align: center;">@RenderUptime(SessionAvg(_boonCoverage, subB.Value, false))</td>
                                            }
                                            <td style="border-left: 1px solid var(--mud-palette-divider);"></td>
                                        </tr>
                                    </tfoot>
                                </MudSimpleTable>
                            }
                        </MudTabPanel>
                    </MudTabs>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
}

@code {
    private bool _loadingSessions = true;
    private bool _loadingSelected = false;
    private List<SessionSummary>? _sessions;
    private SessionSummary? _selected;
    private PreviousSession? _selectedSession;
    private List<EncounterBoonCoverage>? _boonCoverage;

    protected override async Task OnInitializedAsync()
    {
        _loadingSessions = true;
        try
        {
            _sessions = await Http.GetFromJsonAsync<List<SessionSummary>>("api/stats/sessions?limit=30");
            // Auto-select the most recent session so the right pane isn't empty
            if (_sessions is { Count: > 0 })
            {
                _selected = _sessions[0];
                _ = LoadSelectedSessionAsync();
            }
        }
        finally
        {
            _loadingSessions = false;
        }
    }

    private async Task OnSessionSelected(SessionSummary? value)
    {
        if (value == null || _selected == value) return;
        _selected = value;
        await LoadSelectedSessionAsync();
    }

    private async Task LoadSelectedSessionAsync()
    {
        if (_selected == null) return;
        _loadingSelected = true;
        _selectedSession = null;
        _boonCoverage = null;
        StateHasChanged();

        try
        {
            var iso = _selected.SessionDate.ToString("o");
            _selectedSession = await Http.GetFromJsonAsync<PreviousSession>(
                $"api/stats/sessions/{Uri.EscapeDataString(iso)}");
        }
        catch (Exception)
        {
            _selectedSession = null;
        }
        finally
        {
            _loadingSelected = false;
            StateHasChanged();
        }

        if (_selectedSession is { Encounters.Count: > 0 })
        {
            try
            {
                var ids = _selectedSession.Encounters.Select(e => e.Id).ToList();
                var resp = await Http.PostAsJsonAsync(
                    "api/boon-coverage/encounters",
                    new { EncounterIds = ids });
                if (resp.IsSuccessStatusCode)
                {
                    _boonCoverage = await resp.Content.ReadFromJsonAsync<List<EncounterBoonCoverage>>();
                    StateHasChanged();
                }
            }
            catch (Exception)
            {
                _boonCoverage = null;
            }
        }
    }

    // --- Render helpers (mirror Home.razor's Session Stats helpers) ---

    private static Color UptimeColor(decimal? pct) => pct switch
    {
        null => Color.Default,
        > 90 => Color.Success,
        > 80 => Color.Warning,
        _ => Color.Error
    };

    // Identify the two "main" subs across the session = top 2 by total player-encounter count.
    // Drops a small kite/utility sub (e.g., 1-player hand-kite) and adapts when subs aren't
    // numbered 1 and 2 (a squad in subs 2 and 4 still shows up correctly). Sorted by sub
    // number so the columns appear left-to-right in numeric order.
    private static List<int> MainSubs(List<EncounterBoonCoverage> encs)
    {
        var ranked = encs
            .SelectMany(e => e.Subs)
            .GroupBy(s => s.SubGroup)
            .Select(g => new { SubGroup = g.Key, TotalPlayers = g.Sum(s => s.PlayerCount) })
            .OrderByDescending(x => x.TotalPlayers)
            .Take(2)
            .Select(x => x.SubGroup)
            .OrderBy(n => n)
            .ToList();
        return ranked;
    }

    // Session-wide mean for one sub × one boon. Unweighted across encounters: each row
    // contributes one number per cell. Nulls (missing sub on that encounter) are skipped.
    private static decimal? SessionAvg(List<EncounterBoonCoverage> encs, int subGroup, bool quickness)
    {
        var values = encs
            .Select(e => e.Subs.FirstOrDefault(s => s.SubGroup == subGroup))
            .Where(s => s != null)
            .Select(s => quickness ? s!.AvgQuicknessUptime : s!.AvgAlacrityUptime)
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToList();
        return values.Count > 0 ? values.Average() : null;
    }

    private RenderFragment RenderUptime(decimal? pct) => __builder =>
    {
        if (pct == null)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
        }
        else
        {
            <MudChip T="string" Size="Size.Small" Color="@UptimeColor(pct)" Variant="Variant.Filled">
                @($"{pct:0}%")
            </MudChip>
        }
    };

    private RenderFragment RenderGenerators(List<BoonGeneratorInfo> generators) => __builder =>
    {
        if (generators.Count == 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
            return;
        }
        var bySub = generators.GroupBy(g => g.SubGroup).OrderBy(g => g.Key);
        <MudStack Spacing="0">
            @foreach (var subGroup in bySub)
            {
                <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.caption" Style="min-width: 28px;"><strong>S@(subGroup.Key):</strong></MudText>
                    @foreach (var gen in subGroup.OrderBy(g => g.Boon))
                    {
                        var letter = gen.Boon == "Quickness" ? "Q" : "A";
                        <MudText Typo="Typo.caption">@letter @gen.AccountName</MudText>
                    }
                </MudStack>
            }
        </MudStack>
    };

    private static string FormatDuration(int durationMs)
    {
        var ts = TimeSpan.FromMilliseconds(durationMs);
        return ts.TotalMinutes >= 1
            ? $"{(int)ts.TotalMinutes}:{ts.Seconds:D2}"
            : $"{ts.Seconds}s";
    }

    private static string FormatSessionTime(double totalSeconds)
    {
        var ts = TimeSpan.FromSeconds(totalSeconds);
        if (ts.TotalHours >= 1)
            return $"{(int)ts.TotalHours}h {ts.Minutes}m";
        return $"{ts.Minutes}m";
    }

    // --- DTOs (mirror server records) ---

    public record SessionSummary(
        DateTimeOffset SessionDate,
        int TotalAttempts,
        int TotalKills,
        double TotalTimeSeconds,
        double DowntimeSeconds);

    public record PreviousSession(
        DateTimeOffset SessionTime,
        List<SessionEncounter> Encounters,
        int TotalAttempts,
        int TotalKills,
        double TotalTimeSeconds,
        double DowntimeSeconds);

    public record SessionEncounter(
        Guid Id,
        string BossName,
        bool Success,
        bool IsCM,
        DateTimeOffset EncounterTime,
        int DurationMs,
        string? LogUrl);

    public record EncounterBoonCoverage(
        Guid EncounterId,
        string BossName,
        bool IsCM,
        bool Success,
        int DurationMs,
        DateTimeOffset EncounterTime,
        List<SubBoonCoverage> Subs,
        List<BoonGeneratorInfo> Generators);

    public record SubBoonCoverage(
        int SubGroup,
        int PlayerCount,
        decimal? AvgQuicknessUptime,
        decimal? AvgAlacrityUptime);

    public record BoonGeneratorInfo(
        string AccountName,
        string Profession,
        string Role,
        int SubGroup,
        string Boon,
        decimal? GenerationPct);
}
