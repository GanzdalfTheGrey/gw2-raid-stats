@* Per-encounter boon uptime as heatmap cards. Each card carries its own column
   labels, so there is no sticky-header problem. Cells are color-tinted by threshold;
   a sub row expands inline to its per-player rows. Used by Home and Sessions. *@

<style>
    .boon-grid-scroll { overflow-x: auto; }
    .boon-grid {
        border-collapse: separate;
        border-spacing: 3px;
        width: 100%;
    }
    .boon-grid th {
        font-size: 0.72rem;
        font-weight: 600;
        color: var(--mud-palette-text-secondary);
        text-align: center;
        padding: 2px 4px;
        white-space: nowrap;
    }
    .boon-grid td {
        text-align: center;
        padding: 5px 8px;
        min-width: 54px;
        border-radius: 4px;
        font-size: 0.8rem;
    }
    .boon-grid th.boon-label,
    .boon-grid td.boon-label {
        text-align: left;
        min-width: 0;
        white-space: nowrap;
        padding-left: 6px;
    }
    .boon-sub-row { cursor: pointer; }
    .boon-sub-row:hover td { filter: brightness(1.15); }
</style>

@if (Coverage is null || Coverage.Count == 0)
{
    <MudAlert Severity="Severity.Info">No coverage data for this session.</MudAlert>
}
else
{
    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
        Average boon self-uptime per sub (excludes dead/down time). Green / amber / red by
        threshold — % boons: &gt; 90 / &gt; 80 / ≤ 80; Might (avg stacks): ≥ 20 / ≥ 15 / below.
        A red-outlined cell means the sub average is fine but exactly one member is in the red —
        click the sub to expand its players.
    </MudText>

    <MudStack Spacing="3">
        @foreach (var enc in Coverage)
        {
            <MudPaper Class="pa-3" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    <MudText Typo="Typo.subtitle1"><strong>@enc.BossName</strong></MudText>
                    @if (enc.IsCM)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">CM</MudChip>
                    }
                    <MudChip T="string" Size="Size.Small"
                             Color="@(enc.Success ? Color.Success : Color.Error)" Variant="Variant.Text">
                        @(enc.Success ? "Kill" : "Wipe")
                    </MudChip>
                </MudStack>

                @foreach (var subGroup in MainSubs())
                {
                    var boonerText = BoonerText(enc, subGroup);
                    if (boonerText.Length > 0)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            <strong>Sub @subGroup</strong> — @boonerText
                        </MudText>
                    }
                }

                <div class="boon-grid-scroll mt-2">
                    <table class="boon-grid">
                        <thead>
                            <tr>
                                <th class="boon-label"></th>
                                @foreach (var b in Boons)
                                {
                                    <th>@b.Label</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subGroup in MainSubs())
                            {
                                var sub = enc.Subs.FirstOrDefault(s => s.SubGroup == subGroup);
                                var canExpand = sub is { Players.Count: > 0 };
                                <tr class="@(canExpand ? "boon-sub-row" : "")"
                                    @onclick="@(() => { if (canExpand) ToggleExpand(enc, subGroup); })">
                                    <td class="boon-label">
                                        @if (canExpand)
                                        {
                                            <MudIcon Icon="@(IsExpanded(enc, subGroup) ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                     Size="Size.Small" Style="vertical-align: middle;" />
                                        }
                                        <strong>Sub @subGroup</strong>
                                    </td>
                                    @foreach (var b in Boons)
                                    {
                                        <td style="@CellStyle(b.Get(sub?.Average), b.IsMight, Outlier(sub, b))">
                                            @Format(b.Get(sub?.Average), b.IsMight)
                                        </td>
                                    }
                                </tr>
                                @if (canExpand && IsExpanded(enc, subGroup))
                                {
                                    @foreach (var p in sub!.Players)
                                    {
                                        <tr>
                                            <td class="boon-label" style="padding-left: 28px;">
                                                <MudText Typo="Typo.caption">@p.AccountName</MudText>
                                            </td>
                                            @foreach (var b in Boons)
                                            {
                                                <td style="@CellStyle(b.Get(p.Boons), b.IsMight, false)">
                                                    @Format(b.Get(p.Boons), b.IsMight)
                                                </td>
                                            }
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </MudPaper>
        }

        @* Session average — same grid, one row per main sub, no expand *@
        <MudPaper Class="pa-3" Elevation="0" Style="background-color: var(--mud-palette-background-gray);">
            <MudText Typo="Typo.subtitle2" Class="mb-1"><strong>Session average</strong></MudText>
            <div class="boon-grid-scroll">
                <table class="boon-grid">
                    <thead>
                        <tr>
                            <th class="boon-label"></th>
                            @foreach (var b in Boons)
                            {
                                <th>@b.Label</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var subGroup in MainSubs())
                        {
                            var avg = SessionAverage(subGroup);
                            <tr>
                                <td class="boon-label"><strong>Sub @subGroup</strong></td>
                                @foreach (var b in Boons)
                                {
                                    <td style="@CellStyle(b.Get(avg), b.IsMight, false)">
                                        @Format(b.Get(avg), b.IsMight)
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </MudPaper>
    </MudStack>
}

@code {
    [Parameter] public List<EncounterBoonCoverage>? Coverage { get; set; }

    private readonly HashSet<(Guid, int)> _expanded = new();

    private record BoonDef(string Label, Func<BoonSet?, decimal?> Get, bool IsMight);

    private static readonly BoonDef[] Boons =
    {
        new("Quick", b => b?.Quickness,    false),
        new("Alac",  b => b?.Alacrity,     false),
        new("Might", b => b?.Might,        true),
        new("Fury",  b => b?.Fury,         false),
        new("Regen", b => b?.Regeneration, false),
        new("Prot",  b => b?.Protection,   false),
        new("Swift", b => b?.Swiftness,    false),
    };

    private bool IsExpanded(EncounterBoonCoverage enc, int subGroup)
        => _expanded.Contains((enc.EncounterId, subGroup));

    private void ToggleExpand(EncounterBoonCoverage enc, int subGroup)
    {
        var key = (enc.EncounterId, subGroup);
        if (!_expanded.Remove(key)) _expanded.Add(key);
    }

    // The two subs used most across the session (by total player-encounter count) — drops a
    // small kite/utility sub and adapts when subs aren't numbered 1 and 2.
    private List<int> MainSubs()
        => Coverage!
            .SelectMany(e => e.Subs)
            .GroupBy(s => s.SubGroup)
            .Select(g => new { g.Key, Total = g.Sum(s => s.PlayerCount) })
            .OrderByDescending(x => x.Total)
            .Take(2)
            .Select(x => x.Key)
            .OrderBy(n => n)
            .ToList();

    private BoonSet? SessionAverage(int subGroup)
    {
        var subs = Coverage!
            .Select(e => e.Subs.FirstOrDefault(s => s.SubGroup == subGroup))
            .Where(s => s != null)
            .Select(s => s!.Average)
            .ToList();
        if (subs.Count == 0) return null;
        return new BoonSet(
            Mean(subs.Select(a => a.Quickness)),
            Mean(subs.Select(a => a.Alacrity)),
            Mean(subs.Select(a => a.Might)),
            Mean(subs.Select(a => a.Fury)),
            Mean(subs.Select(a => a.Regeneration)),
            Mean(subs.Select(a => a.Protection)),
            Mean(subs.Select(a => a.Swiftness)));
    }

    private static decimal? Mean(IEnumerable<decimal?> values)
    {
        var nonNull = values.Where(v => v.HasValue).Select(v => v!.Value).ToList();
        return nonNull.Count == 0 ? null : nonNull.Average();
    }

    // Red outline only for the clean "one bad apple" case: exactly one member in the red
    // and every other member green (no yellows, no second red).
    private bool Outlier(SubBoonCoverage? sub, BoonDef boon)
    {
        if (sub == null) return false;
        var values = sub.Players
            .Select(p => boon.Get(p.Boons))
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .ToList();
        if (values.Count < 2) return false;
        if (values.Count(v => Band(v, boon.IsMight) == 1) != 1) return false;
        return values.Where(v => Band(v, boon.IsMight) != 1)
                     .All(v => Band(v, boon.IsMight) == 3);
    }

    // 0 = no data, 1 = red, 2 = yellow, 3 = green.
    private static int Band(decimal? v, bool isMight)
    {
        if (v == null) return 0;
        if (isMight) return v >= 20 ? 3 : v >= 15 ? 2 : 1;
        return v > 90 ? 3 : v > 80 ? 2 : 1;
    }

    private static string CellStyle(decimal? v, bool isMight, bool outlier)
    {
        var bg = Band(v, isMight) switch
        {
            3 => "rgba(102, 187, 106, 0.28)",
            2 => "rgba(255, 167, 38, 0.30)",
            1 => "rgba(239, 83, 80, 0.34)",
            _ => "transparent"
        };
        var ring = outlier ? " box-shadow: inset 0 0 0 2px rgb(239, 83, 80);" : "";
        return $"background-color: {bg};{ring}";
    }

    private static string Format(decimal? v, bool isMight)
        => v == null ? "—" : isMight ? $"{v:0.0}" : $"{v:0}%";

    private string BoonerText(EncounterBoonCoverage enc, int subGroup)
    {
        var gens = enc.Generators
            .Where(g => g.SubGroup == subGroup)
            .OrderBy(g => g.Boon)
            .Select(g => $"{(g.Boon == "Quickness" ? "Quick" : "Alac")} {g.AccountName}")
            .ToList();
        return gens.Count == 0 ? "" : string.Join(" · ", gens);
    }
}
